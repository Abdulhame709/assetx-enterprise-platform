# AssetX Backend environment (Phase PRE-P3.1)
# Copy to .env (or set via shell) per environment. All values are overridable.

# Server port (required for co-running with the web app; web runs on :3000).
PORT=3001

# CORS allowed origin(s). Comma-separated list or '*' (dev only).
# Production: set to the exact web origin(s), never '*'.
CORS_ORIGIN=http://localhost:3000

# --- Secrets (REQUIRED in production — inject via secret manager/Vault, never commit) ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# --- Logging ---
# LOG_LEVEL=debug
