# AssetX Backend environment
# Copy to .env (or inject through a secret manager) per environment.

NODE_ENV=development

# Server port (required for co-running with the web app; web runs on :3000).
PORT=3001

# CORS allowed origin(s). Comma-separated list or '*' (dev only).
# Production: set to the exact web origin(s), never '*'.
CORS_ORIGIN=http://localhost:3000

# --- Database ---
# Leave unset for local PGlite development. Set in staging/production.
DATABASE_URL=postgresql://app_user:change-me@localhost:5432/assetx
# Apply numbered SQL migrations during startup only in controlled staging.
RUN_MIGRATIONS=false
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
DB_MAX_USES=0

# --- Secrets (REQUIRED in production — inject via secret manager/Vault, never commit) ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# --- AI (optional; disabled by default) ---
# Never place AI_API_KEY in GitHub or any NEXT_PUBLIC_* variable.
AI_ENABLED=false
AI_PROVIDER=openai-compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=15000
AI_MAX_OUTPUT_TOKENS=900

# --- Logging ---
# LOG_LEVEL=debug
