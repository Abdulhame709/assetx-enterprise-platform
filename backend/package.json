{
  "name": "assetx-backend",
  "version": "0.1.0",
  "description": "AssetX Enterprise Platform — Backend Foundation (NestJS, Clean Architecture, PostgreSQL)",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "test": "jest --config test/jest.config.js",
    "test:unit": "jest --config test/jest.unit.config.js",
    "test:integration": "jest --config test/jest.integration.config.js",
    "test:security": "jest --config test/jest.integration.config.js --testPathPattern security",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.0",
    "@nestjs/schedule": "^6.1.3",
    "bcryptjs": "^2.4.3",
    "exceljs": "^4.4.0",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.19.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/testing": "^10.4.22",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
