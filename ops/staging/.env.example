# Copy to ops/staging/.env locally or configure these variables in the deployment secret store.
# Never commit the populated .env file.

CORS_ORIGIN=https://staging.example.com
DATABASE_URL=postgresql://assetx_app:replace-me@staging-db.example.com:5432/assetx
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
DB_POOL_MAX=20
WEB_PORT=3000
