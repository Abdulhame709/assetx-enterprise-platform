<Window x:Class="AssetManagement.Views.InventoryCyclesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إدارة دورات الجرد السنوي"
        Height="750" Width="1100"
        MinHeight="600" MinWidth="900"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- ═══ ستايل الأزرار العامة ═══ -->
        <Style x:Key="BtnStyle" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ ستايل بطاقات الإحصائيات ═══ -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="1" Opacity="0.15" BlurRadius="5"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ ستايل العناوين ═══ -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#34495E"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- ═══ ستايل حقول الإدخال ═══ -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- العنوان -->
            <RowDefinition Height="Auto"/>
            <!-- نموذج الإدخال -->
            <RowDefinition Height="Auto"/>
            <!-- أزرار العمليات -->
            <RowDefinition Height="*"/>
            <!-- جدول الدورات -->
            <RowDefinition Height="Auto"/>
            <!-- الإحصائيات -->
            <RowDefinition Height="Auto"/>
            <!-- أزرار سفلية -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- Row 0: العنوان الرئيسي -->
        <!-- ═══════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#2C3E50" CornerRadius="8" Padding="15,10" Margin="0,0,0,12">
            <Grid>
                <TextBlock Text="📋 إدارة دورات الجرد السنوي" 
                           FontSize="22" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Right"/>
                <TextBlock x:Name="txtCurrentInfo" 
                           FontSize="12" Foreground="#BDC3C7"
                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- Row 1: نموذج إدخال بيانات الدورة -->
        <!-- ═══════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,8">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" Opacity="0.1" BlurRadius="5"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="25"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="25"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <!-- السطر الأول: السنة + اسم الدورة + الحالة -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="سنة الجرد:" Style="{StaticResource LabelStyle}"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtYear" 
                         Style="{StaticResource InputStyle}" MaxLength="4"
                         TextChanged="txtYear_TextChanged"/>

                <TextBlock Grid.Row="0" Grid.Column="3" Text="اسم الدورة:" Style="{StaticResource LabelStyle}"/>
                <TextBox Grid.Row="0" Grid.Column="4" x:Name="txtCycleName" 
                         Style="{StaticResource InputStyle}"/>

                <TextBlock Grid.Row="0" Grid.Column="6" Text="الحالة:" Style="{StaticResource LabelStyle}"/>
                <TextBox Grid.Row="0" Grid.Column="7" x:Name="txtStatus" 
                         Style="{StaticResource InputStyle}" IsReadOnly="True"
                         Background="#ECF0F1" Text="جديدة"/>

                <!-- السطر الثاني: تاريخ البداية + تاريخ النهاية -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="تاريخ البداية:" Style="{StaticResource LabelStyle}" Margin="0,8,8,0"/>
                <DatePicker Grid.Row="1" Grid.Column="1" x:Name="dpStartDate" 
                            Height="32" FontSize="13" Margin="0,8,0,0"
                            FlowDirection="LeftToRight"/>

                <TextBlock Grid.Row="1" Grid.Column="3" Text="تاريخ النهاية:" Style="{StaticResource LabelStyle}" Margin="0,8,8,0"/>
                <DatePicker Grid.Row="1" Grid.Column="4" x:Name="dpEndDate" 
                            Height="32" FontSize="13" Margin="0,8,0,0"
                            FlowDirection="LeftToRight" HorizontalAlignment="Left" Width="200"/>

                <!-- السطر الثالث: الملاحظات -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="ملاحظات:" Style="{StaticResource LabelStyle}" Margin="0,8,8,0"/>
                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="7" x:Name="txtNotes" 
                         Style="{StaticResource InputStyle}" Margin="0,8,0,0"/>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- Row 2: أزرار العمليات الرئيسية -->
        <!-- ═══════════════════════════════════════════════ -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,8" HorizontalAlignment="Right">

            <Button Content="🆕 جديد" Background="#3498DB" 
                    Style="{StaticResource BtnStyle}" Click="btnNew_Click"/>

            <Button Content="📋 إنشاء دورة + نسخ الأصول" Background="#27AE60" 
                    Style="{StaticResource BtnStyle}" Click="btnCreate_Click"
                    x:Name="btnCreate"/>

            <Button Content="💾 حفظ التعديلات" Background="#F39C12" 
                    Style="{StaticResource BtnStyle}" Click="btnSave_Click"
                    x:Name="btnSave"/>

            <Button Content="▶ بدء الجرد" Background="#8E44AD" 
                    Style="{StaticResource BtnStyle}" Click="btnStartInventory_Click"
                    x:Name="btnStart"/>

            <Button Content="🔒 إغلاق الدورة" Background="#E67E22" 
                    Style="{StaticResource BtnStyle}" Click="btnCloseCycle_Click"
                    x:Name="btnClose"/>

            <Button Content="🗑 حذف الدورة" Background="#E74C3C" 
                    Style="{StaticResource BtnStyle}" Click="btnDelete_Click"
                    x:Name="btnDelete"/>

            <Button Content="🔄 تحديث" Background="#7F8C8D" 
                    Style="{StaticResource BtnStyle}" Click="btnRefresh_Click"/>
        </WrapPanel>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- Row 3: جدول الدورات -->
        <!-- ═══════════════════════════════════════════════ -->
        <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="5" Margin="0,0,0,8">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" Opacity="0.1" BlurRadius="5"/>
            </Border.Effect>
            <DataGrid x:Name="dgCycles"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      AlternatingRowBackground="#F8F9FA"
                      RowHeight="35"
                      ColumnHeaderHeight="38"
                      FontSize="13"
                      BorderThickness="0"
                      SelectionChanged="dgCycles_SelectionChanged">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#34495E"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding CycleID}" Width="50"/>
                    <DataGridTextColumn Header="اسم الدورة" Binding="{Binding CycleName}" Width="*" MinWidth="150"/>
                    <DataGridTextColumn Header="السنة" Binding="{Binding CycleYear}" Width="70"/>
                    <DataGridTextColumn Header="تاريخ البداية" Binding="{Binding StartDate, StringFormat=\{0:yyyy/MM/dd\}}" Width="110"/>
                    <DataGridTextColumn Header="تاريخ النهاية" Binding="{Binding EndDate, StringFormat=\{0:yyyy/MM/dd\}}" Width="110"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding CycleStatus}" Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="عدد الأصول" Binding="{Binding TotalAssets}" Width="85"/>
                    <DataGridTextColumn Header="تم جردها" Binding="{Binding InventoriedAssets}" Width="80"/>
                    <DataGridTextColumn Header="نسبة الإنجاز %" Binding="{Binding CompletionPct, StringFormat=\{0:F1\}%}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#27AE60"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- Row 4: لوحة الإحصائيات -->
        <!-- ═══════════════════════════════════════════════ -->
        <Border Grid.Row="4" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,8">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" Opacity="0.1" BlurRadius="5"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="📊 ملخص الدورة المحددة" FontSize="15" FontWeight="Bold" 
                           Foreground="#2C3E50" Margin="0,0,0,10"/>

                <WrapPanel HorizontalAlignment="Center">
                    <!-- إجمالي الأصول -->
                    <Border Style="{StaticResource StatCard}" BorderBrush="#3498DB" BorderThickness="0,3,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="إجمالي الأصول" FontSize="11" Foreground="#7F8C8D" 
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="lblTotal" Text="0" FontSize="22" FontWeight="Bold" 
                                       Foreground="#3498DB" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- تم جردها -->
                    <Border Style="{StaticResource StatCard}" BorderBrush="#2ECC71" BorderThickness="0,3,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="تم جردها" FontSize="11" Foreground="#7F8C8D" 
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="lblInventoried" Text="0" FontSize="22" FontWeight="Bold" 
                                       Foreground="#2ECC71" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- مطابق -->
                    <Border Style="{StaticResource StatCard}" BorderBrush="#27AE60" BorderThickness="0,3,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="✅ مطابق" FontSize="11" Foreground="#7F8C8D" 
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="lblMatched" Text="0" FontSize="22" FontWeight="Bold" 
                                       Foreground="#27AE60" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- عجز -->
                    <Border Style="{StaticResource StatCard}" BorderBrush="#F39C12" BorderThickness="0,3,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="⚠ عجز" FontSize="11" Foreground="#7F8C8D" 
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="lblDeficit" Text="0" FontSize="22" FontWeight="Bold" 
                                       Foreground="#F39C12" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- زيادة -->
                    <Border Style="{StaticResource StatCard}" BorderBrush="#9B59B6" BorderThickness="0,3,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📦 زيادة" FontSize="11" Foreground="#7F8C8D" 
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="lblSurplus" Text="0" FontSize="22" FontWeight="Bold" 
                                       Foreground="#9B59B6" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- منقول -->
                    <Border Style="{StaticResource StatCard}" BorderBrush="#3498DB" BorderThickness="0,3,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🔄 منقول" FontSize="11" Foreground="#7F8C8D" 
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="lblTransferred" Text="0" FontSize="22" FontWeight="Bold" 
                                       Foreground="#3498DB" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- مفقود -->
                    <Border Style="{StaticResource StatCard}" BorderBrush="#E74C3C" BorderThickness="0,3,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="❌ مفقود" FontSize="11" Foreground="#7F8C8D" 
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="lblMissing" Text="0" FontSize="22" FontWeight="Bold" 
                                       Foreground="#E74C3C" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- لم يُجرد -->
                    <Border Style="{StaticResource StatCard}" BorderBrush="#95A5A6" BorderThickness="0,3,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="⏳ لم يُجرد" FontSize="11" Foreground="#7F8C8D" 
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="lblNotInventoried" Text="0" FontSize="22" FontWeight="Bold" 
                                       Foreground="#95A5A6" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- Row 5: أزرار سفلية (الانتقال لشاشات أخرى) -->
        <!-- ═══════════════════════════════════════════════ -->
        <Border Grid.Row="5" Background="White" CornerRadius="8" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                <Button Content="📋 فتح شاشة الجرد الميداني" Background="#2C3E50" 
                        Style="{StaticResource BtnStyle}" Click="btnOpenInventoryEntry_Click"
                        x:Name="btnOpenEntry" FontSize="14" Padding="25,10"/>

                <Button Content="📊 عرض تقرير ملخص الجرد" Background="#16A085" 
                        Style="{StaticResource BtnStyle}" Click="btnShowSummary_Click"
                        x:Name="btnSummary" FontSize="14" Padding="25,10"/>

                <Button Content="✖ إغلاق" Background="#7F8C8D" 
                        Style="{StaticResource BtnStyle}" Click="btnCloseWindow_Click"
                        FontSize="14" Padding="25,10"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>