<Window x:Class="AssetManagement.Views.SettingsForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إعدادات النظام"
        Width="600" Height="620"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- العنوان -->
        <TextBlock Text="⚙️  إعدادات النظام" FontSize="22"
                  FontWeight="Bold" Foreground="#1565C0"
                  Margin="0,0,0,20"/>

        <!-- الإعدادات -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- اسم المنشأة -->
                <Border Background="#F5F5F5" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🏢  اسم المنشأة" FontSize="14"
                                  FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBox x:Name="txtOrgName" FontSize="14" Padding="10,8"/>
                    </StackPanel>
                </Border>

                <!-- عنوان التقارير -->
                <Border Background="#F5F5F5" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="📄  عنوان التقارير" FontSize="14"
                                  FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBox x:Name="txtReportTitle" FontSize="14" Padding="10,8"/>
                    </StackPanel>
                </Border>

                <!-- تذييل التقارير -->
                <Border Background="#F5F5F5" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="📝  تذييل التقارير" FontSize="14"
                                  FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBox x:Name="txtReportFooter" FontSize="14" Padding="10,8"/>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════ -->
                <!-- ★★★ القسم المضاف: مجلد النسخ الاحتياطي ★★★ -->
                <!-- ═══════════════════════════════════════ -->
                <Border Background="#FFF3E0" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="📂  مجلد النسخ الاحتياطي" FontSize="14"
                                  FontWeight="SemiBold" Foreground="#E65100" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtBackupDir" FontSize="13" Padding="10,8"
                                    FlowDirection="LeftToRight"
                                    Text="C:\AssetBackups"/>
                            <Button Grid.Column="1" Content="تصفح..." FontSize="13"
                                   Padding="15,5" Margin="8,0,0,0"
                                   Background="#FF9800" Foreground="White"
                                   BorderThickness="0" Cursor="Hand"
                                   Click="BtnBrowseBackupDir_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══ النسخ الاحتياطي التلقائي ═══ -->
                <Border Background="#E3F2FD" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🔄  النسخ الاحتياطي التلقائي" FontSize="14"
                                  FontWeight="SemiBold" Foreground="#1565C0" Margin="0,0,0,8"/>

                        <!-- تفعيل/تعطيل -->
                        <CheckBox x:Name="chkAutoBackup" Content="  تفعيل النسخ الاحتياطي التلقائي"
                                 FontSize="14" Margin="0,0,0,12"
                                 Checked="ChkAutoBackup_Changed"
                                 Unchecked="ChkAutoBackup_Changed"/>

                        <!-- الجدولة -->
                        <StackPanel x:Name="pnlAutoBackupOptions">
                            <TextBlock Text="توقيت النسخ:" FontSize="13"
                                      Foreground="#424242" Margin="0,0,0,5"/>
                            <ComboBox x:Name="cmbBackupSchedule" FontSize="14" Padding="8,6"
                                     Margin="0,0,0,10">
                                <ComboBoxItem Content="عند فتح البرنامج" Tag="OnOpen"/>
                                <ComboBoxItem Content="عند إغلاق البرنامج" Tag="OnClose"/>
                                <ComboBoxItem Content="كل ساعة" Tag="Hourly"/>
                                <ComboBoxItem Content="يومياً" Tag="Daily"/>
                                <ComboBoxItem Content="أسبوعياً" Tag="Weekly"/>
                                <ComboBoxItem Content="شهرياً" Tag="Monthly"/>
                            </ComboBox>

                            <!-- عدد النسخ المحفوظة -->
                            <TextBlock Text="عدد النسخ المحفوظة:" FontSize="13"
                                      Foreground="#424242" Margin="0,0,0,5"/>
                            <ComboBox x:Name="cmbKeepCount" FontSize="14" Padding="8,6"
                                     Margin="0,0,0,10">
                                <ComboBoxItem Content="5 نسخ" Tag="5"/>
                                <ComboBoxItem Content="10 نسخ" Tag="10"/>
                                <ComboBoxItem Content="20 نسخة" Tag="20"/>
                                <ComboBoxItem Content="30 نسخة" Tag="30"/>
                                <ComboBoxItem Content="50 نسخة" Tag="50"/>
                            </ComboBox>

                            <!-- آخر نسخ -->
                            <TextBlock x:Name="txtLastBackup" Text="آخر نسخ: لم يتم بعد"
                                      FontSize="12" Foreground="#757575" Margin="0,5,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- طريقة الإهلاك -->
                <Border Background="#F5F5F5" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="📉  طريقة حساب الإهلاك" FontSize="14"
                                  FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ComboBox x:Name="cmbDepMethod" FontSize="14" Padding="8,6">
                            <ComboBoxItem Content="القسط الثابت"/>
                            <ComboBoxItem Content="القسط المتناقص"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- بداية السنة المالية -->
                <Border Background="#F5F5F5" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="📅  شهر بداية السنة المالية" FontSize="14"
                                  FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ComboBox x:Name="cmbFiscalMonth" FontSize="14" Padding="8,6">
                            <ComboBoxItem Content="1 - يناير"/>
                            <ComboBoxItem Content="2 - فبراير"/>
                            <ComboBoxItem Content="3 - مارس"/>
                            <ComboBoxItem Content="4 - أبريل"/>
                            <ComboBoxItem Content="5 - مايو"/>
                            <ComboBoxItem Content="6 - يونيو"/>
                            <ComboBoxItem Content="7 - يوليو"/>
                            <ComboBoxItem Content="8 - أغسطس"/>
                            <ComboBoxItem Content="9 - سبتمبر"/>
                            <ComboBoxItem Content="10 - أكتوبر"/>
                            <ComboBoxItem Content="11 - نوفمبر"/>
                            <ComboBoxItem Content="12 - ديسمبر"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- شعار المنشأة -->
                <Border Background="#F5F5F5" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🖼️  شعار المنشأة" FontSize="14"
                                  FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtLogoPath" FontSize="13" Padding="10,8"
                                    FlowDirection="LeftToRight" IsReadOnly="True"/>
                            <Button Grid.Column="1" Content="اختيار صورة" FontSize="13"
                                   Padding="15,5" Margin="8,0,0,0"
                                   Background="#9C27B0" Foreground="White"
                                   BorderThickness="0" Cursor="Hand"
                                   Click="BtnBrowseLogo_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- الأزرار -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                   HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="💾  حفظ الإعدادات" Background="#4CAF50"
                   Foreground="White" FontSize="15" FontWeight="Bold"
                   Padding="40,12" Margin="5"
                   BorderThickness="0" Cursor="Hand"
                   Click="BtnSave_Click"/>
            <Button Content="❌  إلغاء" Background="#9E9E9E"
                   Foreground="White" FontSize="15"
                   Padding="30,12" Margin="5"
                   BorderThickness="0" Cursor="Hand"
                   Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>