<Window x:Class="AssetManagement.Views.MainLocationsForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إدارة المواقع الرئيسية"
        Height="680" Width="950"
        MinHeight="580" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI"
        FontSize="14"
        Background="#F5F5F5"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="15,5">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#1565C0"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════ -->
        <!-- العنوان                                     -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#1565C0" CornerRadius="8"
                Padding="15,10" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="🏢" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="إدارة المواقع الرئيسية (المباني)"
                               FontSize="20" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- وضع النموذج -->
                <Border Grid.Column="1" Background="#1976D2" CornerRadius="5" Padding="10,3">
                    <TextBlock x:Name="txtFormMode" Text="وضع العرض"
                               Foreground="White" FontSize="12" FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════ -->
        <!-- حقول الإدخال                                -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="White" CornerRadius="8"
                Padding="20,15" Margin="0,0,0,10"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- السطر 1: الكود والاسم -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="الكود:"
                           Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Row="0" Grid.Column="1"
                         x:Name="txtLocationCode"
                         Style="{StaticResource InputField}"
                         IsEnabled="False"
                         Background="#F5F5F5"
                         MaxLength="20"/>

                <TextBlock Grid.Row="0" Grid.Column="3" Text="اسم الموقع:"
                           Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Row="0" Grid.Column="4"
                         x:Name="txtLocationName"
                         Style="{StaticResource InputField}"
                         MaxLength="100"/>

                <!-- السطر 2: المسؤول ومعلومات الاتصال -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="المسؤول:"
                           Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Row="2" Grid.Column="1"
                         x:Name="txtResponsiblePerson"
                         Style="{StaticResource InputField}"
                         MaxLength="100"/>

                <TextBlock Grid.Row="2" Grid.Column="3" Text="معلومات الاتصال:"
                           Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Row="2" Grid.Column="4"
                         x:Name="txtContactInfo"
                         Style="{StaticResource InputField}"
                         MaxLength="100"/>

                <!-- السطر 3: الوصف -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="الوصف:"
                           Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4"
                         x:Name="txtDescription"
                         Style="{StaticResource InputField}"
                         MaxLength="300"/>

                <!-- السطر 4: نشط + معلومات إضافية -->
                <CheckBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                          x:Name="chkIsActive"
                          Content="  نشط (مفعّل)"
                          IsChecked="True"
                          FontSize="14"
                          VerticalAlignment="Center"/>

                <!-- عدد المواقع الفرعية -->
                <StackPanel Grid.Row="6" Grid.Column="3" Grid.ColumnSpan="2"
                            Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🚪" FontSize="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="المواقع الفرعية:" FontSize="13" Foreground="#666" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtSubLocationsCount" Text="0" 
                               FontSize="14" FontWeight="Bold" Foreground="#1565C0"
                               Margin="5,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- حقول مخفية -->
                <TextBox x:Name="txtLocationID" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════ -->
        <!-- أزرار التحكم                                -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Row="2" Margin="0,0,0,10">
            <WrapPanel HorizontalAlignment="Center">
                <Button x:Name="btnNew" Content="➕ جديد"
                        Background="#4CAF50" Foreground="White"
                        Style="{StaticResource ActionButton}"
                        Click="btnNew_Click"/>
                <Button x:Name="btnSave" Content="💾 حفظ"
                        Background="#1565C0" Foreground="White"
                        Style="{StaticResource ActionButton}"
                        Click="btnSave_Click"/>
                <Button x:Name="btnEdit" Content="✏️ تعديل"
                        Background="#FF8F00" Foreground="White"
                        Style="{StaticResource ActionButton}"
                        Click="btnEdit_Click" IsEnabled="False"/>
                <Button x:Name="btnDelete" Content="🗑️ حذف"
                        Background="#D32F2F" Foreground="White"
                        Style="{StaticResource ActionButton}"
                        Click="btnDelete_Click" IsEnabled="False"/>
                <Button x:Name="btnToggleActive" Content="🔄 تغيير الحالة"
                        Background="#7B1FA2" Foreground="White"
                        Style="{StaticResource ActionButton}"
                        Click="btnToggleActive_Click" IsEnabled="False"/>
                <Button x:Name="btnCancel" Content="↩️ إلغاء"
                        Background="#757575" Foreground="White"
                        Style="{StaticResource ActionButton}"
                        Click="btnCancel_Click"/>
            </WrapPanel>
        </Border>

        <!-- ═══════════════════════════════════════════ -->
        <!-- جدول البيانات                               -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Row="3" Background="White" CornerRadius="8"
                BorderBrush="#E0E0E0" BorderThickness="1"
                Margin="0,0,0,10">
            <DataGrid x:Name="dgLocations"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      Background="White"
                      RowBackground="White"
                      AlternatingRowBackground="#F5F5F5"
                      FontSize="14"
                      ColumnHeaderHeight="40"
                      RowHeight="35"
                      SelectionChanged="dgLocations_SelectionChanged">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1565C0"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Right"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="م" Binding="{Binding MainLocationID}" Width="50"/>
                    <DataGridTextColumn Header="الكود" Binding="{Binding MainLocationCode}" Width="70"/>
                    <DataGridTextColumn Header="اسم الموقع" Binding="{Binding MainLocationName}" Width="180"/>
                    <DataGridTextColumn Header="المسؤول" Binding="{Binding ResponsiblePerson}" Width="120"/>
                    <DataGridTextColumn Header="الاتصال" Binding="{Binding ContactInfo}" Width="100"/>
                    <DataGridTextColumn Header="الوصف" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="الفرعية" Binding="{Binding SubLocCount}" Width="60"/>
                    <DataGridCheckBoxColumn Header="نشط" Binding="{Binding IsActive}" Width="55"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ═══════════════════════════════════════════ -->
        <!-- شريط الحالة                                 -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Row="4" Background="#263238" CornerRadius="5" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="txtFormStatus" Text="جاهز"
                           Foreground="#B0BEC5" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="txtRecordCount" Text="عدد السجلات: 0"
                           Foreground="#B0BEC5" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>