<Window x:Class="AssetManagement.Views.StatusForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إدارة حالات الأصول"
        Height="600" Width="800"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI"
        FontSize="14"
        Background="#F5F5F5"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- ستايل الأزرار -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="15,5">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ستايل حقول الإدخال -->
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#1565C0"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ستايل العناوين -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- العنوان -->
            <RowDefinition Height="Auto"/>
            <!-- حقول الإدخال -->
            <RowDefinition Height="Auto"/>
            <!-- الأزرار -->
            <RowDefinition Height="*"/>
            <!-- الجدول -->
            <RowDefinition Height="Auto"/>
            <!-- شريط الحالة -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════ -->
        <!-- الصف 1: العنوان                             -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#1565C0" CornerRadius="8" 
                Padding="15,10" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📊" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="إدارة حالات الأصول"
                           FontSize="20" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════ -->
        <!-- الصف 2: حقول الإدخال                        -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="White" CornerRadius="8"
                Padding="20,15" Margin="0,0,0,10"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- السطر 1: الكود والاسم -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="الكود:"
                           Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Row="0" Grid.Column="1"
                         x:Name="txtStatusCode"
                         Style="{StaticResource InputField}"
                         MaxLength="20"/>

                <TextBlock Grid.Row="0" Grid.Column="3" Text="اسم الحالة:"
                           Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Row="0" Grid.Column="4"
                         x:Name="txtStatusName"
                         Style="{StaticResource InputField}"
                         MaxLength="50"/>

                <!-- السطر 2: الوصف -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="الوصف:"
                           Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4"
                         x:Name="txtDescription"
                         Style="{StaticResource InputField}"
                         MaxLength="200"/>

                <!-- السطر 3: اللون والحالة -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="اللون:"
                           Style="{StaticResource FieldLabel}"/>
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="txtStatusColor"
                             Style="{StaticResource InputField}"
                             Width="100"
                             MaxLength="20"
                             Text="#000000"/>
                    <Border x:Name="brdColorPreview"
                            Width="35" Height="35"
                            CornerRadius="5"
                            Background="#000000"
                            Margin="5,0,0,0"
                            BorderBrush="#BDBDBD"
                            BorderThickness="1"/>
                </StackPanel>

                <CheckBox Grid.Row="4" Grid.Column="3" Grid.ColumnSpan="2"
                          x:Name="chkIsActive"
                          Content="  نشط (مفعّل)"
                          IsChecked="True"
                          FontSize="14"
                          VerticalAlignment="Center"/>

                <!-- حقل مخفي لحفظ رقم السجل -->
                <TextBox x:Name="txtStatusID" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════ -->
        <!-- الصف 3: أزرار التحكم                        -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Row="2" Margin="0,0,0,10">
            <WrapPanel HorizontalAlignment="Center">

                <Button x:Name="btnNew"
                        Content="➕ جديد"
                        Background="#4CAF50" Foreground="White"
                        Style="{StaticResource ActionButton}"
                        Click="btnNew_Click"/>

                <Button x:Name="btnSave"
                        Content="💾 حفظ"
                        Background="#1565C0" Foreground="White"
                        Style="{StaticResource ActionButton}"
                        Click="btnSave_Click"/>

                <Button x:Name="btnEdit"
                        Content="✏️ تعديل"
                        Background="#FF8F00" Foreground="White"
                        Style="{StaticResource ActionButton}"
                        Click="btnEdit_Click"
                        IsEnabled="False"/>

                <Button x:Name="btnDelete"
                        Content="🗑️ حذف"
                        Background="#D32F2F" Foreground="White"
                        Style="{StaticResource ActionButton}"
                        Click="btnDelete_Click"
                        IsEnabled="False"/>

                <Button x:Name="btnCancel"
                        Content="↩️ إلغاء"
                        Background="#757575" Foreground="White"
                        Style="{StaticResource ActionButton}"
                        Click="btnCancel_Click"/>

            </WrapPanel>
        </Border>

        <!-- ═══════════════════════════════════════════ -->
        <!-- الصف 4: جدول البيانات                       -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Row="3" Background="White" CornerRadius="8"
                BorderBrush="#E0E0E0" BorderThickness="1"
                Margin="0,0,0,10">
            <DataGrid x:Name="dgStatus"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      Background="White"
                      RowBackground="White"
                      AlternatingRowBackground="#F5F5F5"
                      FontSize="14"
                      ColumnHeaderHeight="40"
                      RowHeight="35"
                      SelectionChanged="dgStatus_SelectionChanged">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1565C0"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Right"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="م" 
                                        Binding="{Binding StatusID}" 
                                        Width="50"/>
                    <DataGridTextColumn Header="الكود" 
                                        Binding="{Binding StatusCode}" 
                                        Width="80"/>
                    <DataGridTextColumn Header="اسم الحالة" 
                                        Binding="{Binding StatusName}" 
                                        Width="150"/>
                    <DataGridTextColumn Header="الوصف" 
                                        Binding="{Binding Description}" 
                                        Width="*"/>
                    <DataGridTextColumn Header="اللون" 
                                        Binding="{Binding StatusColor}" 
                                        Width="80"/>
                    <DataGridCheckBoxColumn Header="نشط" 
                                            Binding="{Binding IsActive}" 
                                            Width="60"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ═══════════════════════════════════════════ -->
        <!-- الصف 5: شريط الحالة                         -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Row="4" Background="#263238" CornerRadius="5" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           x:Name="txtFormStatus"
                           Text="جاهز"
                           Foreground="#B0BEC5"
                           FontSize="12"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           x:Name="txtRecordCount"
                           Text="عدد السجلات: 0"
                           Foreground="#B0BEC5"
                           FontSize="12"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>