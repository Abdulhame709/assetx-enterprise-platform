<Window x:Class="AssetManagement.Views.InventoryEntryView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="شاشة الجرد الميداني"
        Height="850" Width="1300" MinHeight="700" MinWidth="1000"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen"
        WindowState="Maximized" Background="#F0F2F5" Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="BtnStyle" TargetType="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MiniCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
        <Style x:Key="LblStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#34495E"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: العنوان -->
        <Border Grid.Row="0" Background="#2C3E50" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="الجرد الميداني - " FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="txtCycleName" FontSize="18" FontWeight="Bold" Foreground="#F1C40F"/>
                </StackPanel>
                <TextBlock x:Name="txtProgress" FontSize="13" Foreground="#BDC3C7" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Row 1: الإحصائيات -->
        <WrapPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,6">
            <Border Style="{StaticResource MiniCard}" BorderBrush="#3498DB" BorderThickness="0,2,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="الكل: " FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                    <TextBlock x:Name="lblSTotal" Text="0" FontSize="15" FontWeight="Bold" Foreground="#3498DB"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MiniCard}" BorderBrush="#2ECC71" BorderThickness="0,2,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="مطابق: " FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                    <TextBlock x:Name="lblSMatched" Text="0" FontSize="15" FontWeight="Bold" Foreground="#2ECC71"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MiniCard}" BorderBrush="#F39C12" BorderThickness="0,2,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="عجز: " FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                    <TextBlock x:Name="lblSDeficit" Text="0" FontSize="15" FontWeight="Bold" Foreground="#F39C12"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MiniCard}" BorderBrush="#9B59B6" BorderThickness="0,2,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="زيادة: " FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                    <TextBlock x:Name="lblSSurplus" Text="0" FontSize="15" FontWeight="Bold" Foreground="#9B59B6"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MiniCard}" BorderBrush="#1ABC9C" BorderThickness="0,2,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="منقول: " FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                    <TextBlock x:Name="lblSTransferred" Text="0" FontSize="15" FontWeight="Bold" Foreground="#1ABC9C"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MiniCard}" BorderBrush="#E74C3C" BorderThickness="0,2,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="مفقود: " FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                    <TextBlock x:Name="lblSMissing" Text="0" FontSize="15" FontWeight="Bold" Foreground="#E74C3C"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MiniCard}" BorderBrush="#95A5A6" BorderThickness="0,2,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="لم يُجرد: " FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                    <TextBlock x:Name="lblSNotDone" Text="0" FontSize="15" FontWeight="Bold" Foreground="#95A5A6"/>
                </StackPanel>
            </Border>
        </WrapPanel>

        <!-- Row 2: الفلاتر (مع النوع الفرعي) -->
        <Border Grid.Row="2" Background="White" CornerRadius="6" Padding="8" Margin="0,0,0,6">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="بحث:" Style="{StaticResource LblStyle}"/>
                <TextBox x:Name="txtSearch" Width="140" Height="26" FontSize="12" Padding="4,2" Margin="0,0,8,0" TextChanged="txtSearch_TextChanged"/>
                <TextBlock Text="الموقع:" Style="{StaticResource LblStyle}"/>
                <ComboBox x:Name="cmbFilterLocation" Width="120" Height="26" FontSize="11" Margin="0,0,4,0" SelectionChanged="cmbFilterLocation_SelectionChanged"/>
                <TextBlock Text="الفرعي:" Style="{StaticResource LblStyle}"/>
                <ComboBox x:Name="cmbFilterSubLocation" Width="110" Height="26" FontSize="11" Margin="0,0,8,0" SelectionChanged="cmbFilterSubLocation_SelectionChanged"/>
                <TextBlock Text="الموظف:" Style="{StaticResource LblStyle}"/>
                <ComboBox x:Name="cmbFilterEmployee" Width="120" Height="26" FontSize="11" Margin="0,0,8,0" SelectionChanged="cmbFilterEmployee_SelectionChanged"/>
                <TextBlock Text="النوع:" Style="{StaticResource LblStyle}"/>
                <ComboBox x:Name="cmbFilterSubType" Width="120" Height="26" FontSize="11" Margin="0,0,8,0" SelectionChanged="cmbFilterSubType_SelectionChanged"/>
                <TextBlock Text="النتيجة:" Style="{StaticResource LblStyle}"/>
                <ComboBox x:Name="cmbFilterResult" Width="90" Height="26" FontSize="11" Margin="0,0,8,0" SelectionChanged="cmbFilterResult_SelectionChanged"/>
                <TextBlock x:Name="txtRecordCount" Text="عدد: 0" FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Center" Margin="5,0,0,0"/>
                <Button Content="تحديث" Background="#7F8C8D" Style="{StaticResource BtnStyle}" Click="btnRefresh_Click" Margin="6,0,0,0"/>
                <Button Content="مطابقة سريعة للموقع" Background="#27AE60" Style="{StaticResource BtnStyle}" Click="btnQuickMatchLocation_Click"/>
            </WrapPanel>
        </Border>

        <!-- Row 3: الجدول (النوع الفرعي + العهدة الفعلية) -->
        <Border Grid.Row="3" Background="White" CornerRadius="6" Padding="3" Margin="0,0,0,6">
            <DataGrid x:Name="dgRecords" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False"
                      GridLinesVisibility="Horizontal" AlternatingRowBackground="#F8F9FA"
                      RowHeight="30" ColumnHeaderHeight="33" FontSize="11" BorderThickness="0"
                      SelectionChanged="dgRecords_SelectionChanged">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#34495E"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="10"/>
                        <Setter Property="Padding" Value="5,4"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding RecordID}" Width="40"/>
                    <DataGridTextColumn Header="الكود" Binding="{Binding BaseAssetCode}" Width="80"/>
                    <DataGridTextColumn Header="اسم الأصل" Binding="{Binding AssetName}" Width="*" MinWidth="120"/>
                    <DataGridTextColumn Header="النوع الفرعي" Binding="{Binding SubTypeName}" Width="85"/>
                    <DataGridTextColumn Header="العهدة" Binding="{Binding EmployeeName}" Width="80"/>
                    <DataGridTextColumn Header="الموقع م" Binding="{Binding ExpectedMainLocName}" Width="80"/>
                    <DataGridTextColumn Header="الفرعي م" Binding="{Binding ExpectedSubLocName}" Width="80"/>
                    <DataGridTextColumn Header="كمية م" Binding="{Binding ExpectedQuantity}" Width="45"/>
                    <DataGridTextColumn Header="حالة م" Binding="{Binding ExpectedStatusName}" Width="65"/>
                    <DataGridTextColumn Header="الموقع ف" Binding="{Binding ActualMainLocName}" Width="80"/>
                    <DataGridTextColumn Header="الفرعي ف" Binding="{Binding ActualSubLocName}" Width="80"/>
                    <DataGridTextColumn Header="كمية ف" Binding="{Binding ActualQuantity}" Width="45"/>
                    <DataGridTextColumn Header="حالة ف" Binding="{Binding ActualStatusName}" Width="65"/>
                    <DataGridTextColumn Header="العهدة ف" Binding="{Binding ActualEmployeeName}" Width="80"/>
                    <DataGridTextColumn Header="النتيجة" Binding="{Binding InventoryResult}" Width="60">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Row 4: لوحة الإدخال (مع الموظف الفعلي) -->
        <Border Grid.Row="4" Background="White" CornerRadius="6" Padding="10" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- السطر 0: معلومات الأصل -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="الأصل:" Style="{StaticResource LblStyle}" FontWeight="Bold"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="8" x:Name="txtSelectedAsset"
                               FontSize="12" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center" TextWrapping="Wrap"/>

                    <!-- السطر 1: الموقع والكمية والحالة والموظف -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="الموقع:" Style="{StaticResource LblStyle}" Margin="0,6,5,0"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cmbActualMainLoc" Height="26" FontSize="11" Margin="0,6,0,0"
                              SelectionChanged="cmbActualMainLoc_SelectionChanged"/>

                    <TextBlock Grid.Row="1" Grid.Column="3" Text="الفرعي:" Style="{StaticResource LblStyle}" Margin="0,6,5,0"/>
                    <ComboBox Grid.Row="1" Grid.Column="4" x:Name="cmbActualSubLoc" Height="26" FontSize="11" Margin="0,6,0,0"/>

                    <TextBlock Grid.Row="1" Grid.Column="6" Text="الكمية:" Style="{StaticResource LblStyle}" Margin="0,6,5,0"/>
                    <TextBox Grid.Row="1" Grid.Column="7" x:Name="txtActualQty" Height="26" FontSize="12" Padding="4,2"
                             Margin="0,6,0,0" HorizontalContentAlignment="Center"/>

                    <TextBlock Grid.Row="1" Grid.Column="9" Text="الحالة:" Style="{StaticResource LblStyle}" Margin="0,6,5,0"/>
                    <ComboBox Grid.Row="1" Grid.Column="10" x:Name="cmbActualStatus" Height="26" FontSize="11" Margin="0,6,0,0"/>

                    <TextBlock Grid.Row="1" Grid.Column="12" Text="العهدة:" Style="{StaticResource LblStyle}" Margin="0,6,5,0"/>
                    <ComboBox Grid.Row="1" Grid.Column="13" x:Name="cmbActualEmployee" Height="26" FontSize="11" Margin="0,6,0,0"/>

                    <TextBlock Grid.Row="1" Grid.Column="15" Text="ملاحظات:" Style="{StaticResource LblStyle}" Margin="0,6,5,0"/>
                    <TextBox Grid.Row="1" Grid.Column="16" x:Name="txtEntryNotes" Height="26" FontSize="11" Padding="4,2" Margin="0,6,0,0"/>

                    <!-- السطر 2: المتوقع -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="المتوقع:" Style="{StaticResource LblStyle}" Foreground="#7F8C8D" Margin="0,4,5,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="16" x:Name="txtExpectedInfo"
                               FontSize="10" Foreground="#7F8C8D" VerticalAlignment="Center" Margin="0,4,0,0"/>
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button Content="حفظ الجرد" Background="#27AE60" Style="{StaticResource BtnStyle}" Click="btnSaveRecord_Click" Height="32" Padding="18,4"/>
                    <Button Content="مطابق سريع" Background="#3498DB" Style="{StaticResource BtnStyle}" Click="btnQuickMatch_Click" Height="32" Padding="18,4"/>
                    <Button Content="إلغاء الجرد" Background="#E67E22" Style="{StaticResource BtnStyle}" Click="btnResetRecord_Click" Height="32" Padding="18,4"/>
                    <Button Content="تنظيف" Background="#95A5A6" Style="{StaticResource BtnStyle}" Click="btnClearEntry_Click" Height="32" Padding="18,4"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 5: الشريط السفلي -->
        <Border Grid.Row="5" Background="#2C3E50" CornerRadius="6" Padding="8,5">
            <Grid>
                <TextBlock x:Name="txtStatusBar" Text="جاهز" Foreground="#BDC3C7" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="تصدير Excel" Background="#217346" Style="{StaticResource BtnStyle}" Click="btnExportExcel_Click" Margin="4,0"/>
                    <Button Content="طباعة التقرير" Background="#0277BD" Style="{StaticResource BtnStyle}" Click="btnPrint_Click" Margin="4,0"/>
                    <Button Content="طباعة نموذج فارغ" Background="#6A1B9A" Style="{StaticResource BtnStyle}" Click="btnPrintBlankForm_Click" Margin="4,0"/>
                </StackPanel>
                <Button Content="إغلاق" Background="#E74C3C" Style="{StaticResource BtnStyle}" Click="btnCloseWindow_Click" HorizontalAlignment="Left"/>
            </Grid>
        </Border>
    </Grid>
</Window>