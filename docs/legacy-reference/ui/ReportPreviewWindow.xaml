<Window x:Class="AssetManagement.Views.ReportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="معاينة التقرير"
        Width="900" Height="700"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FlowDirection="RightToLeft"
        Background="#F5F5F5">

    <Window.Resources>
        <Style x:Key="ToolBarButton" TargetType="Button">
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="1"
                                      BlurRadius="4"
                                      Opacity="0.2"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="0">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="border"
                                        Property="Opacity"
                                        Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="border"
                                        Property="Opacity"
                                        Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- شريط الأدوات العلوي -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#DEE2E6"
                BorderThickness="0,0,0,1"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal">

                    <Button x:Name="btnPrint"
                            Style="{StaticResource ToolBarButton}"
                            Background="#1565C0"
                            Foreground="White"
                            Click="btnPrint_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖨️" FontSize="14"
                                       Margin="0,0,6,0"/>
                            <TextBlock Text="طباعة"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnExportExcel"
                            Style="{StaticResource ToolBarButton}"
                            Background="#1B7D32"
                            Foreground="White"
                            Click="btnExportExcel_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="14"
                                       Margin="0,0,6,0"/>
                            <TextBlock Text="تصدير Excel"/>
                        </StackPanel>
                    </Button>

                    <Border Width="1" Background="#DEE2E6"
                            Margin="8,4"
                            VerticalAlignment="Stretch"/>

                    <Button x:Name="btnZoomIn"
                            Style="{StaticResource ToolBarButton}"
                            Background="#EDE7F6"
                            Foreground="#4527A0"
                            MinWidth="45"
                            Click="btnZoomIn_Click">
                        <TextBlock Text="➕" FontSize="14"/>
                    </Button>

                    <Button x:Name="btnZoomOut"
                            Style="{StaticResource ToolBarButton}"
                            Background="#EDE7F6"
                            Foreground="#4527A0"
                            MinWidth="45"
                            Click="btnZoomOut_Click">
                        <TextBlock Text="➖" FontSize="14"/>
                    </Button>

                    <TextBlock x:Name="txtZoom"
                               Text="100%"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#4527A0"
                               VerticalAlignment="Center"
                               Margin="8,0"/>

                    <Button x:Name="btnZoomReset"
                            Style="{StaticResource ToolBarButton}"
                            Background="#EDE7F6"
                            Foreground="#4527A0"
                            MinWidth="60"
                            Click="btnZoomReset_Click">
                        <TextBlock Text="🔄 100%"
                                   FontSize="11"/>
                    </Button>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           x:Name="txtReportTitle"
                           Text="معاينة التقرير"
                           FontFamily="Segoe UI"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="#0D47A1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="2"
                        x:Name="btnClose"
                        Style="{StaticResource ToolBarButton}"
                        Background="#EF5350"
                        Foreground="White"
                        MinWidth="80"
                        Click="btnClose_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✖" FontSize="12"
                                   Margin="0,0,6,0"/>
                        <TextBlock Text="إغلاق"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- منطقة المعاينة -->
        <Border Grid.Row="1"
                Background="#ECEFF1"
                Padding="10">
            <DocumentViewer x:Name="docViewer"
                FlowDirection="LeftToRight"
                Background="#ECEFF1"
                BorderThickness="0"/>
        </Border>

        <!-- شريط الحالة السفلي -->
        <Border Grid.Row="2"
                Background="#0D47A1"
                Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           x:Name="txtRecordCount"
                           Text="عدد السجلات: 0"
                           Foreground="#90CAF9"
                           FontSize="11"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           x:Name="txtPageInfo"
                           Text=""
                           Foreground="White"
                           FontSize="11"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2"
                           Text="نظام إدارة الأصول الثابتة"
                           Foreground="#64B5F6"
                           FontSize="10"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>