<Window x:Class="AssetManagement.Views.AssetsReportForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تقارير الأصول"
        Width="1400" Height="800"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI"
        FontSize="14"
        Background="#F0F2F5">

    <Window.Resources>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Cmb" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
        </Style>

        <Style x:Key="SearchableCmb" TargetType="ComboBox" BasedOn="{StaticResource Cmb}">
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="IsTextSearchEnabled" Value="True"/>
            <Setter Property="StaysOpenOnEdit" Value="True"/>
        </Style>

        <Style x:Key="Chk" TargetType="CheckBox">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#344054"/>
        </Style>

        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterTab" TargetType="TabItem">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Foreground" Value="#667085"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#1565C0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FL" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#667085"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ════════════════════════════════════════════════════════════ -->
        <!--  الشريط العلوي                                              -->
        <!-- ════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Padding="16,10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#0D47A1" Offset="0"/>
                    <GradientStop Color="#1976D2" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#FFFFFF22" CornerRadius="8"
                            Padding="8,4" Margin="0,0,10,0">
                        <TextBlock Text="📊" FontSize="20" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="تقارير الأصول الثابتة" Foreground="White"
                                   FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="تصفية وتجميع وطباعة وتصدير"
                                   Foreground="#90CAF9" FontSize="10"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="📊 إنشاء التقرير" Background="#2E7D32"
                            Style="{StaticResource Btn}" Click="btnGenerateReport_Click"/>
                    <Button Content="🖨️ معاينة وطباعة" Background="#7B1FA2"
                            Style="{StaticResource Btn}" Click="btnPrint_Click"/>
                    <Button Content="📥 تصدير Excel" Background="#E65100"
                            Style="{StaticResource Btn}" Click="btnExport_Click"/>
                    <Border Width="1" Background="#FFFFFF44"
                            Margin="6,4" VerticalAlignment="Stretch"/>
                    <Button Background="#455A64" Style="{StaticResource Btn}"
                            Click="btnReset_Click" ToolTip="إعادة تعيين">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" FontSize="13" Margin="0,0,4,0"/>
                            <TextBlock Text="تعيين"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════════ -->
        <!--  الفلاتر + التجميع                                          -->
        <!-- ════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="White" Margin="10,6,10,0"
                CornerRadius="12" BorderBrush="#E4E7EC" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.06"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <TabControl Grid.Column="0" Margin="8,4,4,8"
                            BorderThickness="0" Background="Transparent" Padding="0">

                    <!-- ──── تبويب: الفلاتر ──── -->
                    <TabItem Header="🔍 الفلاتر" Style="{StaticResource FilterTab}">
                        <Border Padding="10,8" Background="#FAFBFC" CornerRadius="0,0,8,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                                    <StackPanel Margin="0,0,10,4" MinWidth="160">
                                        <TextBlock Text="اسم الأصل" Style="{StaticResource FL}"/>
                                        <TextBox x:Name="txtFilterName"
                                                 Style="{StaticResource SearchBox}" Width="160"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,4" MinWidth="145">
                                        <TextBlock Text="النوع الفرعي" Style="{StaticResource FL}"/>
                                        <ComboBox x:Name="cmbFilterType"
              Style="{StaticResource SearchableCmb}"
              Width="145"
              DisplayMemberPath="SubTypeName"
              SelectedValuePath="SubTypeID"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,4" MinWidth="120">
                                        <TextBlock Text="الحالة" Style="{StaticResource FL}"/>
                                        <ComboBox x:Name="cmbFilterStatus"
                                                  Style="{StaticResource SearchableCmb}"
                                                  Width="120"
                                                  DisplayMemberPath="StatusName"
                                                  SelectedValuePath="StatusID"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,4" MinWidth="160">
                                        <TextBlock Text="الموظف" Style="{StaticResource FL}"/>
                                        <ComboBox x:Name="cmbFilterEmployee"
                                                  Style="{StaticResource SearchableCmb}"
                                                  Width="160"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="EmployeeID"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,4" MinWidth="135">
                                        <TextBlock Text="الموديل" Style="{StaticResource FL}"/>
                                        <ComboBox x:Name="cmbFilterModel"
                                                  Style="{StaticResource SearchableCmb}"
                                                  Width="135"
                                                  DisplayMemberPath="ModelName"
                                                  SelectedValuePath="ModelID"/>
                                    </StackPanel>
                                </WrapPanel>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Style="{StaticResource FL}">
                                            <Run Text="🏢 الموقع الرئيسي"/>
                                        </TextBlock>
                                        <ComboBox x:Name="cmbFilterMainLoc"
                                                  Style="{StaticResource SearchableCmb}"
                                                  DisplayMemberPath="MainLocationName"
                                                  SelectedValuePath="MainLocationID"
                                                  SelectionChanged="cmbFilterMainLoc_SelectionChanged"/>
                                        <Border x:Name="pnlSelectedLocation"
                                                Background="#E3F2FD" CornerRadius="6"
                                                Padding="8,3" Margin="0,4,0,0"
                                                Visibility="Collapsed">
                                            <TextBlock x:Name="txtSelectedLocationInfo"
                                                       FontSize="10" Foreground="#1565C0"
                                                       TextWrapping="Wrap"/>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource FL}">
                                            <Run Text="📍 الموقع الفرعي (هرمي)"/>
                                        </TextBlock>

                                        <Grid Margin="0,0,0,3">
                                            <TextBox x:Name="txtSearchSubLoc"
                                                     Style="{StaticResource SearchBox}"
                                                     Height="28" FontSize="11"
                                                     TextChanged="txtSearchSubLoc_TextChanged"/>
                                            <TextBlock x:Name="txtSearchSubLocHint"
                                                       Text="🔍 ابحث..." FontSize="10"
                                                       Foreground="#B0B0B0"
                                                       IsHitTestVisible="False"
                                                       VerticalAlignment="Center"
                                                       Margin="10,0,0,0"/>
                                        </Grid>

                                        <Border BorderBrush="#D0D5DD" BorderThickness="1"
                                                CornerRadius="6" Background="White"
                                                MaxHeight="120" ClipToBounds="True">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <TreeView x:Name="tvSubLocations"
                                                          BorderThickness="0"
                                                          Background="Transparent"
                                                          FontSize="11"
                                                          SelectedItemChanged="tvSubLocations_SelectedItemChanged"
                                                          IsEnabled="False">
                                                    <TreeView.ItemContainerStyle>
                                                        <Style TargetType="TreeViewItem">
                                                            <Setter Property="IsExpanded" Value="True"/>
                                                            <Setter Property="Padding" Value="2,1"/>
                                                        </Style>
                                                    </TreeView.ItemContainerStyle>
                                                </TreeView>
                                            </ScrollViewer>
                                        </Border>

                                        <Button x:Name="btnClearSubLoc"
                                                Content="✖ مسح الاختيار"
                                                FontSize="9" Background="#FFF3E0"
                                                Foreground="#E65100" Padding="6,2"
                                                Margin="0,3,0,0" Cursor="Hand"
                                                BorderThickness="0"
                                                HorizontalAlignment="Right"
                                                Click="btnClearSubLoc_Click"
                                                Visibility="Collapsed">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="4"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </TabItem>

                    <!-- ──── تبويب: متقدم ──── -->
                    <TabItem Header="⚙️ متقدم" Style="{StaticResource FilterTab}">
                        <Border Padding="10,8" Background="#FAFBFC" CornerRadius="0,0,8,8">
                            <WrapPanel>
                                <StackPanel Margin="0,0,10,6">
                                    <TextBlock Text="السعر من" Style="{StaticResource FL}"/>
                                    <TextBox x:Name="txtPriceFrom"
                                             Style="{StaticResource SearchBox}" Width="130"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,6">
                                    <TextBlock Text="السعر إلى" Style="{StaticResource FL}"/>
                                    <TextBox x:Name="txtPriceTo"
                                             Style="{StaticResource SearchBox}" Width="130"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,6">
                                    <TextBlock Text="تاريخ الشراء من" Style="{StaticResource FL}"/>
                                    <DatePicker x:Name="dpDateFrom"
                                                Height="32" FontSize="11" Width="140"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,6">
                                    <TextBlock Text="تاريخ الشراء إلى" Style="{StaticResource FL}"/>
                                    <DatePicker x:Name="dpDateTo"
                                                Height="32" FontSize="11" Width="140"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,6">
                                    <TextBlock Text="سنة الجرد" Style="{StaticResource FL}"/>
                                    <TextBox x:Name="txtInventoryYear"
                                             Style="{StaticResource SearchBox}" Width="100"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,6">
                                    <TextBlock Text="الباركود" Style="{StaticResource FL}"/>
                                    <TextBox x:Name="txtBarcode"
                                             Style="{StaticResource SearchBox}" Width="160"/>
                                </StackPanel>
                            </WrapPanel>
                        </Border>
                    </TabItem>
                </TabControl>

                <!-- ═══════════════════════════════════════ -->
                <!--  بطاقة التجميع والأعمدة                 -->
                <!-- ═══════════════════════════════════════ -->
                <Border Grid.Column="1" Background="#F8FAFC"
                        CornerRadius="0,12,12,0"
                        BorderBrush="#E4E7EC" BorderThickness="1,0,0,0"
                        Padding="12,8">
                    <StackPanel>
                        <Border Background="#EDE7F6" CornerRadius="6"
                                Padding="6,3" Margin="0,0,0,8"
                                HorizontalAlignment="Right">
                            <TextBlock Text="📊 التجميع والأعمدة"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="#4527A0"/>
                        </Border>

                        <TextBlock Text="تجميع حسب:" Style="{StaticResource FL}"/>
                        <ComboBox x:Name="cmbGroupField"
                                  Style="{StaticResource Cmb}" Margin="0,0,0,8">
                            <ComboBoxItem Content="-- بدون --" Tag="" IsSelected="True"/>
                            <ComboBoxItem Content="📝 اسم الأصل" Tag="AssetName"/>
                            <ComboBoxItem Content="📂 نوع الأصل" Tag="AssetTypeName"/>
                            <ComboBoxItem Content="📁 النوع الفرعي" Tag="SubTypeName"/>
                            <ComboBoxItem Content="🏢 الموقع الرئيسي" Tag="MainLocationName"/>
                            <ComboBoxItem Content="📍 الموقع الفرعي" Tag="SubLocationName"/>
                            <ComboBoxItem Content="🔵 الحالة" Tag="StatusName"/>
                            <ComboBoxItem Content="👤 الموظف" Tag="EmployeeName"/>
                            <ComboBoxItem Content="📱 الموديل" Tag="ModelName"/>
                        </ComboBox>

                        <TextBlock Text="أعمدة إضافية:" Style="{StaticResource FL}"
                                   Margin="0,0,0,4"/>
                        <Border Background="White" CornerRadius="6"
                                BorderBrush="#E4E7EC" BorderThickness="1"
                                Padding="4">
                            <WrapPanel>
                                <CheckBox x:Name="chkColAssetName"
                                          Content="📝 اسم الأصل"
                                          Style="{StaticResource Chk}"
                                          IsChecked="True"/>
                                <CheckBox x:Name="chkColSubType"
                                          Content="📁 النوع"
                                          Style="{StaticResource Chk}"/>
                                <CheckBox x:Name="chkColMainLoc"
                                          Content="🏢 الموقع"
                                          Style="{StaticResource Chk}"/>
                                <CheckBox x:Name="chkColSubLoc"
                                          Content="📍 الفرعي"
                                          Style="{StaticResource Chk}"/>
                                <CheckBox x:Name="chkColStatus"
                                          Content="🔵 الحالة"
                                          Style="{StaticResource Chk}"/>
                                <CheckBox x:Name="chkColEmployee"
                                          Content="👤 الموظف"
                                          Style="{StaticResource Chk}"/>
                                <CheckBox x:Name="chkColModel"
                                          Content="📱 الموديل"
                                          Style="{StaticResource Chk}"/>
                                <CheckBox x:Name="chkColPrice"
                                          Content="💰 السعر"
                                          Style="{StaticResource Chk}"/>
                                <CheckBox x:Name="chkColDate"
                                          Content="📅 التاريخ"
                                          Style="{StaticResource Chk}"/>
                                <CheckBox x:Name="chkColNotes"
                                          Content="📝 ملاحظات"
                                          Style="{StaticResource Chk}"/>
                            </WrapPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════════ -->
        <!--  بطاقات الإحصائيات                                          -->
        <!-- ════════════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled" Margin="10,6,10,0">
            <WrapPanel HorizontalAlignment="Right">
                <Border Style="{StaticResource StatCard}">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#E3F2FD" CornerRadius="8"
                                Padding="6,4" Margin="0,0,8,0">
                            <TextBlock Text="📋" FontSize="18" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="السجلات" FontSize="9" Foreground="#667085"/>
                            <TextBlock x:Name="txtSumCount" Text="0" FontSize="20"
                                       FontWeight="Bold" Foreground="#1565C0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCard}">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#E8F5E9" CornerRadius="8"
                                Padding="6,4" Margin="0,0,8,0">
                            <TextBlock Text="📦" FontSize="18" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="الكمية" FontSize="9" Foreground="#667085"/>
                            <TextBlock x:Name="txtSumQty" Text="0" FontSize="20"
                                       FontWeight="Bold" Foreground="#2E7D32"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCard}">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#FFF3E0" CornerRadius="8"
                                Padding="6,4" Margin="0,0,8,0">
                            <TextBlock Text="💰" FontSize="18" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="القيمة" FontSize="9" Foreground="#667085"/>
                            <TextBlock x:Name="txtSumValue" Text="0" FontSize="20"
                                       FontWeight="Bold" Foreground="#E65100"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCard}">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#F3E5F5" CornerRadius="8"
                                Padding="6,4" Margin="0,0,8,0">
                            <TextBlock Text="🏢" FontSize="18" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="المواقع" FontSize="9" Foreground="#667085"/>
                            <TextBlock x:Name="txtSumLocations" Text="0" FontSize="20"
                                       FontWeight="Bold" Foreground="#7B1FA2"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCard}">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#E0F7FA" CornerRadius="8"
                                Padding="6,4" Margin="0,0,8,0">
                            <TextBlock Text="📂" FontSize="18" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="الأنواع" FontSize="9" Foreground="#667085"/>
                            <TextBlock x:Name="txtSumTypes" Text="0" FontSize="20"
                                       FontWeight="Bold" Foreground="#00695C"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </ScrollViewer>

        <!-- ════════════════════════════════════════════════════════════ -->
        <!--  ✅ تبويبات العرض: تقرير مخصص + تقرير تفصيلي               -->
        <!-- ════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Background="White" Margin="10,6,10,4"
                CornerRadius="12" BorderBrush="#E4E7EC" BorderThickness="1"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.06"/>
            </Border.Effect>

            <TabControl x:Name="tcReportView" BorderThickness="0" Background="Transparent" Padding="0">

                <!-- ──── تبويب: التقرير المخصص (الأصلي) ──── -->
                <TabItem Header="📊 التقرير المخصص" Style="{StaticResource FilterTab}"
                         FontSize="13" Padding="16,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- شريط البحث -->
                        <Border Grid.Row="0" Background="#FAFBFC" Padding="12,8"
                                BorderBrush="#E4E7EC" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="0,0,10,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="🔎" FontSize="14" Margin="0,0,4,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="بحث:" FontSize="11" Foreground="#667085"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBox Grid.Column="1" x:Name="txtSearchResult"
                                         Style="{StaticResource SearchBox}"
                                         TextChanged="txtSearchResult_TextChanged"
                                         MaxWidth="500"/>
                                <Border Grid.Column="2" Background="#E3F2FD" CornerRadius="6"
                                        Padding="10,4" Margin="10,0,0,0">
                                    <TextBlock x:Name="txtResultCount" Text="0 سجل"
                                               FontSize="11" Foreground="#1565C0"
                                               FontWeight="Bold" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- جدول البيانات المخصص -->
                        <DataGrid Grid.Row="1" x:Name="dgReport"
                                  AutoGenerateColumns="True"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  GridLinesVisibility="Horizontal"
                                  AlternatingRowBackground="#F8FAFC"
                                  RowBackground="White"
                                  BorderThickness="0"
                                  FontSize="12"
                                  ColumnHeaderHeight="38"
                                  RowHeight="32"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#0D47A1"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#E3F2FD"/>
                                            <Setter Property="Foreground" Value="#0D47A1"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- ──── ✅ تبويب: التقرير التفصيلي (جميع الأعمدة) ──── -->
                <TabItem Header="📋 التقرير التفصيلي" Style="{StaticResource FilterTab}"
                         FontSize="13" Padding="16,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- شريط البحث للتفصيلي -->
                        <Border Grid.Row="0" Background="#FFF8E1" Padding="12,8"
                                BorderBrush="#FFE082" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="0,0,10,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="🔎" FontSize="14" Margin="0,0,4,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="بحث في التفصيلي:" FontSize="11"
                                               Foreground="#F57F17"
                                               VerticalAlignment="Center" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBox Grid.Column="1" x:Name="txtSearchDetail"
                                         Style="{StaticResource SearchBox}"
                                         TextChanged="txtSearchDetail_TextChanged"
                                         MaxWidth="500"/>
                                <Border Grid.Column="2" Background="#FFF3E0" CornerRadius="6"
                                        Padding="10,4" Margin="10,0,0,0">
                                    <TextBlock x:Name="txtDetailCount" Text="0 سجل"
                                               FontSize="11" Foreground="#E65100"
                                               FontWeight="Bold" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- جدول التقرير التفصيلي -->
                        <DataGrid Grid.Row="1" x:Name="dgDetailReport"
                                  AutoGenerateColumns="True"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  GridLinesVisibility="Horizontal"
                                  AlternatingRowBackground="#FFFDE7"
                                  RowBackground="White"
                                  BorderThickness="0"
                                  FontSize="12"
                                  ColumnHeaderHeight="38"
                                  RowHeight="32"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#E65100"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#FFF3E0"/>
                                            <Setter Property="Foreground" Value="#E65100"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                        </DataGrid>
                    </Grid>
                </TabItem>

            </TabControl>
        </Border>

        <!-- ════════════════════════════════════════════════════════════ -->
        <!--  الشريط السفلي                                              -->
        <!-- ════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="4" Padding="14,8">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1E293B" Offset="0"/>
                    <GradientStop Color="#334155" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtStatus"
                           Text="💡 اختر الفلاتر ثم اضغط 'إنشاء التقرير'"
                           Foreground="#94A3B8" FontSize="11"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="نظام إدارة الأصول v1.0"
                           Foreground="#64748B" FontSize="9"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>