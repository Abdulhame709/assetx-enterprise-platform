<Window x:Class="AssetManagement.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تسجيل الدخول - نظام إدارة الأصول الثابتة"
        Width="950" Height="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft">

    <Window.Resources>

        <!-- ═══ ستايل حقل الإدخال الحديث ═══ -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="CaretBrush" Value="#1565C0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border"
                                        Property="BorderBrush" Value="#94A3B8"/>
                                <Setter TargetName="border"
                                        Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border"
                                        Property="BorderBrush" Value="#1565C0"/>
                                <Setter TargetName="border"
                                        Property="BorderThickness" Value="2"/>
                                <Setter TargetName="border"
                                        Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ ستايل حقل كلمة المرور ═══ -->
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="CaretBrush" Value="#1565C0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border"
                                        Property="BorderBrush" Value="#94A3B8"/>
                                <Setter TargetName="border"
                                        Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border"
                                        Property="BorderBrush" Value="#1565C0"/>
                                <Setter TargetName="border"
                                        Property="BorderThickness" Value="2"/>
                                <Setter TargetName="border"
                                        Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ ستايل زر تسجيل الدخول ═══ -->
        <Style x:Key="LoginButton" TargetType="Button">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="12"
                                Padding="10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1565C0" Offset="0"/>
                                    <GradientStop Color="#1976D2" Offset="0.5"/>
                                    <GradientStop Color="#1E88E5" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="3"
                                                  Color="#1565C0" Opacity="0.4"
                                                  Direction="270"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#0D47A1" Offset="0"/>
                                            <GradientStop Color="#1565C0" Offset="0.5"/>
                                            <GradientStop Color="#1976D2" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="btnBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="20" ShadowDepth="5"
                                                          Color="#0D47A1" Opacity="0.5"
                                                          Direction="270"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#0A3D91" Offset="0"/>
                                            <GradientStop Color="#0D47A1" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#B0BEC5"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="btnBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="5" ShadowDepth="1"
                                                          Opacity="0.1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- الحاوية الرئيسية بظل خارجي                         -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Border CornerRadius="20" Margin="20" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="35" ShadowDepth="8"
                              Opacity="0.35" Color="#000000"
                              Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- الجانب الأيمن: اللوحة الزرقاء -->
                <ColumnDefinition Width="420"/>
                <!-- الجانب الأيسر: النموذج -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════════════════════════════════════ -->
            <!-- الجانب الأيمن - اللوحة الترويجية             -->
            <!-- ═══════════════════════════════════════════ -->
            <Border Grid.Column="0" CornerRadius="20,0,0,20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0A1628" Offset="0"/>
                        <GradientStop Color="#0D2137" Offset="0.3"/>
                        <GradientStop Color="#0F2B4A" Offset="0.6"/>
                        <GradientStop Color="#1565C0" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <!-- خطوط زخرفية في الخلفية -->
                    <Canvas>
                        <!-- دوائر زخرفية -->
                        <Ellipse Width="300" Height="300"
                                 Canvas.Right="-80" Canvas.Top="-60"
                                 Opacity="0.05" Fill="White"/>
                        <Ellipse Width="200" Height="200"
                                 Canvas.Left="-50" Canvas.Bottom="-40"
                                 Opacity="0.04" Fill="White"/>
                        <Ellipse Width="120" Height="120"
                                 Canvas.Right="40" Canvas.Bottom="100"
                                 Opacity="0.06" Fill="White"/>
                        <Ellipse Width="80" Height="80"
                                 Canvas.Left="30" Canvas.Top="80"
                                 Opacity="0.03" Fill="White"/>

                        <!-- خطوط مائلة زخرفية -->
                        <Line X1="0" Y1="200" X2="420" Y2="350"
                              Stroke="White" StrokeThickness="0.5"
                              Opacity="0.08"/>
                        <Line X1="0" Y1="280" X2="420" Y2="430"
                              Stroke="White" StrokeThickness="0.5"
                              Opacity="0.06"/>
                        <Line X1="0" Y1="360" X2="420" Y2="510"
                              Stroke="White" StrokeThickness="0.5"
                              Opacity="0.04"/>
                    </Canvas>

                    <!-- المحتوى -->
                    <StackPanel VerticalAlignment="Center" Margin="40">

                        <!-- أيقونة رئيسية -->
                        <Border Width="90" Height="90" CornerRadius="22"
                                HorizontalAlignment="Center" Margin="0,0,0,25">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1565C0" Offset="0"/>
                                    <GradientStop Color="#42A5F5" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="4"
                                                  Color="#000000" Opacity="0.3"/>
                            </Border.Effect>
                            <TextBlock Text="🏢" FontSize="44"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- العنوان الرئيسي -->
                        <TextBlock Text="نظام إدارة"
                                   FontSize="28" FontWeight="Light"
                                   Foreground="#90CAF9"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="الأصول الثابتة"
                                   FontSize="32" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,8"/>
                        <TextBlock Text="Fixed Assets Management System"
                                   FontSize="12" Foreground="#5C8DB8"
                                   HorizontalAlignment="Center"
                                   FlowDirection="LeftToRight"
                                   FontFamily="Segoe UI"
                                   FontStyle="Italic"/>

                        <!-- فاصل -->
                        <Border Height="1.5" Width="60"
                                Background="#1E88E5"
                                CornerRadius="1"
                                HorizontalAlignment="Center"
                                Margin="0,25,0,25" Opacity="0.6"/>

                        <!-- الميزات -->
                        <StackPanel HorizontalAlignment="Center" Margin="0,5,0,0">

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Width="32" Height="32" CornerRadius="8"
                                        Background="#1A3A5C" Margin="0,0,12,0">
                                    <TextBlock Text="📦" FontSize="15"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="تتبع الأصول"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="#E3F2FD"/>
                                    <TextBlock Text="إدارة شاملة لجميع الأصول"
                                               FontSize="10" Foreground="#5C8DB8"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Width="32" Height="32" CornerRadius="8"
                                        Background="#1A3A5C" Margin="0,0,12,0">
                                    <TextBlock Text="📋" FontSize="15"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="الجرد السنوي"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="#E3F2FD"/>
                                    <TextBlock Text="جرد ميداني ومراجعة دقيقة"
                                               FontSize="10" Foreground="#5C8DB8"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Width="32" Height="32" CornerRadius="8"
                                        Background="#1A3A5C" Margin="0,0,12,0">
                                    <TextBlock Text="📊" FontSize="15"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="التقارير المتقدمة"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="#E3F2FD"/>
                                    <TextBlock Text="تقارير تفصيلية وإحصائيات"
                                               FontSize="10" Foreground="#5C8DB8"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Border Width="32" Height="32" CornerRadius="8"
                                        Background="#1A3A5C" Margin="0,0,12,0">
                                    <TextBlock Text="🔒" FontSize="15"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="أمان وصلاحيات"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="#E3F2FD"/>
                                    <TextBlock Text="نظام صلاحيات متعدد المستويات"
                                               FontSize="10" Foreground="#5C8DB8"/>
                                </StackPanel>
                            </StackPanel>

                        </StackPanel>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════ -->
            <!-- الجانب الأيسر - نموذج تسجيل الدخول          -->
            <!-- ═══════════════════════════════════════════ -->
            <Border Grid.Column="1" Background="White"
                    CornerRadius="0,20,20,0">
                <Grid>
                    <!-- زر الإغلاق -->
                    <Button Content="✕"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#B0BEC5"
                            FontSize="18" FontWeight="Light"
                            Margin="15,12" Cursor="Hand"
                            Click="BtnClose_Click"
                            ToolTip="إغلاق التطبيق">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="closeBorder"
                                        Background="Transparent"
                                        CornerRadius="8"
                                        Width="32" Height="32">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="closeBorder"
                                                Property="Background" Value="#FFEBEE"/>
                                        <Setter Property="Foreground" Value="#EF5350"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- محتوى النموذج -->
                    <StackPanel VerticalAlignment="Center"
                                Margin="50,0,50,0">

                        <!-- ترحيب -->
                        <TextBlock Text="مرحباً بك 👋"
                                   FontSize="26" FontWeight="Bold"
                                   Foreground="#1E293B"
                                   FontFamily="Segoe UI"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,0,4"/>

                        <TextBlock Text="سجّل دخولك للوصول إلى النظام"
                                   FontSize="13" Foreground="#94A3B8"
                                   FontFamily="Segoe UI"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,0,35"/>

                        <!-- ═══ اسم المستخدم ═══ -->
                        <TextBlock FontSize="13" FontWeight="SemiBold"
                                   Foreground="#475569" Margin="0,0,0,8"
                                   FontFamily="Segoe UI">
                            <Run Text="👤"/>
                            <Run Text="  اسم المستخدم"/>
                        </TextBlock>

                        <TextBox x:Name="txtUsername"
                                 Style="{StaticResource ModernTextBox}"
                                 Margin="0,0,0,20"
                                 FlowDirection="LeftToRight"
                                 HorizontalContentAlignment="Left"/>

                        <!-- ═══ كلمة المرور ═══ -->
                        <TextBlock FontSize="13" FontWeight="SemiBold"
                                   Foreground="#475569" Margin="0,0,0,8"
                                   FontFamily="Segoe UI">
                            <Run Text="🔑"/>
                            <Run Text="  كلمة المرور"/>
                        </TextBlock>

                        <PasswordBox x:Name="txtPassword"
                                     Style="{StaticResource ModernPasswordBox}"
                                     Margin="0,0,0,18"
                                     FlowDirection="LeftToRight"
                                     HorizontalContentAlignment="Left"
                                     KeyDown="TxtPassword_KeyDown"/>

                        <!-- تذكرني -->
                        <CheckBox x:Name="chkRemember"
                                  Margin="0,0,0,22"
                                  FlowDirection="RightToLeft">
                            <TextBlock Text="تذكرني في المرة القادمة"
                                       FontSize="12" Foreground="#64748B"
                                       FontFamily="Segoe UI"/>
                        </CheckBox>

                        <!-- ═══ رسالة الخطأ ═══ -->
                        <Border x:Name="borderError"
                                Visibility="Collapsed"
                                CornerRadius="10"
                                Padding="14,10" Margin="0,0,0,18">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FFF5F5" Offset="0"/>
                                    <GradientStop Color="#FEE2E2" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#FECACA"/>
                            </Border.BorderBrush>
                            <Border.BorderThickness>1</Border.BorderThickness>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠️" FontSize="14"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock x:Name="txtError"
                                           Foreground="#DC2626"
                                           FontSize="12"
                                           FontFamily="Segoe UI"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- ═══ زر تسجيل الدخول ═══ -->
                        <Button x:Name="btnLogin"
                                Style="{StaticResource LoginButton}"
                                Click="BtnLogin_Click"
                                Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="تسجيل الدخول"
                                           FontSize="15" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="  →" FontSize="18"
                                           VerticalAlignment="Center"
                                           Opacity="0.8"
                                           FlowDirection="LeftToRight"/>
                            </StackPanel>
                        </Button>

                        <!-- مؤشر التحميل -->
                        <ProgressBar x:Name="progressLogin"
                                     IsIndeterminate="True"
                                     Height="3" Margin="5,0"
                                     Foreground="#1565C0"
                                     Background="#E2E8F0"
                                     Visibility="Collapsed"/>

                        <!-- ═══ التذييل ═══ -->
                        <StackPanel Margin="0,30,0,0"
                                    HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <Border Width="8" Height="8"
                                        CornerRadius="4"
                                        Background="#4CAF50"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text="متصل بالخادم"
                                           FontSize="11"
                                           Foreground="#94A3B8"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="الإصدار 1.0  ·  2025"
                                       FontSize="10" Foreground="#CBD5E1"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,0"/>
                        </StackPanel>

                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>