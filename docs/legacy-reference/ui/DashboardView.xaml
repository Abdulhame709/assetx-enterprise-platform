<UserControl x:Class="AssetManagement.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <!-- ستايل البطاقات -->
        <Style x:Key="DashCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2"
                                    Opacity="0.15" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="15">

            <!-- ═══ عنوان ═══ -->
            <TextBlock Text="📊  لوحة المعلومات" FontSize="24"
                      FontWeight="Bold" Foreground="#1565C0"
                      Margin="5,0,0,5"/>
            <TextBlock x:Name="txtWelcome" FontSize="14"
                      Foreground="#757575" Margin="5,0,0,20"/>

            <!-- ═══════════════════════════════════ -->
            <!-- الصف الأول: البطاقات الإحصائية -->
            <!-- ═══════════════════════════════════ -->
            <UniformGrid Rows="1" Columns="5" Margin="0,0,0,15">

                <!-- إجمالي الأصول -->
                <Border Style="{StaticResource DashCardStyle}" Background="#E3F2FD">
                    <StackPanel>
                        <TextBlock Text="📦" FontSize="30"/>
                        <TextBlock x:Name="txtTotalAssets" Text="0"
                                  FontSize="32" FontWeight="Bold"
                                  Foreground="#1565C0" Margin="0,5,0,0"/>
                        <TextBlock Text="إجمالي الأصول" FontSize="13"
                                  Foreground="#42A5F5"/>
                    </StackPanel>
                </Border>

                <!-- أصول نشطة -->
                <Border Style="{StaticResource DashCardStyle}" Background="#E8F5E9">
                    <StackPanel>
                        <TextBlock Text="✅" FontSize="30"/>
                        <TextBlock x:Name="txtActiveAssets" Text="0"
                                  FontSize="32" FontWeight="Bold"
                                  Foreground="#2E7D32" Margin="0,5,0,0"/>
                        <TextBlock Text="أصول نشطة" FontSize="13"
                                  Foreground="#66BB6A"/>
                    </StackPanel>
                </Border>

                <!-- تحتاج صيانة -->
                <Border Style="{StaticResource DashCardStyle}" Background="#FFF3E0">
                    <StackPanel>
                        <TextBlock Text="🔧" FontSize="30"/>
                        <TextBlock x:Name="txtMaintenanceAssets" Text="0"
                                  FontSize="32" FontWeight="Bold"
                                  Foreground="#E65100" Margin="0,5,0,0"/>
                        <TextBlock Text="تحتاج صيانة" FontSize="13"
                                  Foreground="#FFA726"/>
                    </StackPanel>
                </Border>

                <!-- تالفة -->
                <Border Style="{StaticResource DashCardStyle}" Background="#FFEBEE">
                    <StackPanel>
                        <TextBlock Text="⚠️" FontSize="30"/>
                        <TextBlock x:Name="txtDamagedAssets" Text="0"
                                  FontSize="32" FontWeight="Bold"
                                  Foreground="#C62828" Margin="0,5,0,0"/>
                        <TextBlock Text="تالفة / مفقودة" FontSize="13"
                                  Foreground="#EF5350"/>
                    </StackPanel>
                </Border>

                <!-- إجمالي القيمة -->
                <Border Style="{StaticResource DashCardStyle}" Background="#F3E5F5">
                    <StackPanel>
                        <TextBlock Text="💰" FontSize="30"/>
                        <TextBlock x:Name="txtTotalValue" Text="0"
                                  FontSize="26" FontWeight="Bold"
                                  Foreground="#6A1B9A" Margin="0,5,0,0"/>
                        <TextBlock Text="إجمالي القيمة" FontSize="13"
                                  Foreground="#AB47BC"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ═══════════════════════════════════ -->
            <!-- الصف الثاني: معلومات الجرد + آخر الحركات -->
            <!-- ═══════════════════════════════════ -->
            <Grid Margin="0,5,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- بطاقة الجرد الحالي -->
                <Border Grid.Column="0" Style="{StaticResource DashCardStyle}"
                       Background="White" BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="📋  دورة الجرد الحالية" FontSize="16"
                                  FontWeight="Bold" Foreground="#1565C0"
                                  Margin="0,0,0,15"/>

                        <StackPanel x:Name="panelNoCycle" Visibility="Visible">
                            <TextBlock Text="لا توجد دورة جرد نشطة" FontSize="14"
                                      Foreground="#9E9E9E"
                                      HorizontalAlignment="Center" Margin="0,20"/>
                        </StackPanel>

                        <StackPanel x:Name="panelCycleInfo" Visibility="Collapsed">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="اسم الدورة:" FontSize="13"
                                          Foreground="#757575" Margin="0,0,10,0"/>
                                <TextBlock x:Name="txtCycleName" Grid.Column="1"
                                          FontSize="13" FontWeight="SemiBold"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="الحالة:" FontSize="13"
                                          Foreground="#757575" Margin="0,0,10,0"/>
                                <TextBlock x:Name="txtCycleStatus" Grid.Column="1"
                                          FontSize="13" FontWeight="SemiBold"/>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="نسبة الإنجاز:" FontSize="13"
                                          Foreground="#757575" Margin="0,0,10,0"/>
                                <TextBlock x:Name="txtCycleProgress" Grid.Column="1"
                                          FontSize="13" FontWeight="SemiBold"/>
                            </Grid>

                            <!-- شريط التقدم -->
                            <ProgressBar x:Name="progressCycle" Height="12"
                                       Minimum="0" Maximum="100" Value="0"
                                       Foreground="#4CAF50"
                                       Background="#E0E0E0"/>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock x:Name="txtInventoried" Text="0"
                                             FontSize="20" FontWeight="Bold"
                                             Foreground="#4CAF50"
                                             HorizontalAlignment="Center"/>
                                    <TextBlock Text="تم جرده" FontSize="11"
                                             Foreground="#757575"
                                             HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock x:Name="txtNotInventoried" Text="0"
                                             FontSize="20" FontWeight="Bold"
                                             Foreground="#FF9800"
                                             HorizontalAlignment="Center"/>
                                    <TextBlock Text="لم يُجرد" FontSize="11"
                                             Foreground="#757575"
                                             HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock x:Name="txtIssues" Text="0"
                                             FontSize="20" FontWeight="Bold"
                                             Foreground="#F44336"
                                             HorizontalAlignment="Center"/>
                                    <TextBlock Text="ملاحظات" FontSize="11"
                                             Foreground="#757575"
                                             HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- آخر الحركات -->
                <Border Grid.Column="1" Style="{StaticResource DashCardStyle}"
                       Background="White" BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="🔄  آخر الحركات" FontSize="16"
                                  FontWeight="Bold" Foreground="#1565C0"
                                  Margin="0,0,0,10"/>

                        <DataGrid x:Name="dgRecentMovements"
                                 AutoGenerateColumns="False"
                                 IsReadOnly="True"
                                 HeadersVisibility="Column"
                                 GridLinesVisibility="Horizontal"
                                 BorderThickness="0"
                                 FontSize="12"
                                 MaxHeight="200"
                                 CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="التاريخ"
                                    Binding="{Binding MovementDate, StringFormat={}{0:MM/dd}}"
                                    Width="60"/>
                                <DataGridTextColumn Header="الأصل"
                                    Binding="{Binding AssetName}" Width="*"/>
                                <DataGridTextColumn Header="النوع"
                                    Binding="{Binding MovementType}" Width="60"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock x:Name="txtNoMovements"
                                  Text="لا توجد حركات حديثة" FontSize="13"
                                  Foreground="#9E9E9E"
                                  HorizontalAlignment="Center" Margin="0,20"
                                  Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══════════════════════════════════ -->
            <!-- الصف الثالث: الأصول حسب النوع + حسب الموقع -->
            <!-- ═══════════════════════════════════ -->
            <Grid Margin="0,5,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- الأصول حسب النوع -->
                <Border Grid.Column="0" Style="{StaticResource DashCardStyle}"
                       Background="White" BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="📁  الأصول حسب النوع" FontSize="16"
                                  FontWeight="Bold" Foreground="#1565C0"
                                  Margin="0,0,0,10"/>
                        <ItemsControl x:Name="icAssetsByType">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding TypeName}"
                                                      FontSize="13" Foreground="#424242"/>
                                            <ProgressBar Value="{Binding Percentage}"
                                                       Maximum="100" Height="8"
                                                       Foreground="{Binding Color}"
                                                       Background="#E0E0E0"
                                                       Margin="0,3,10,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                  Text="{Binding Count}"
                                                  FontSize="16" FontWeight="Bold"
                                                  Foreground="#1565C0"
                                                  VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- الأصول حسب الحالة -->
                <Border Grid.Column="1" Style="{StaticResource DashCardStyle}"
                       Background="White" BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="📊  الأصول حسب الحالة" FontSize="16"
                                  FontWeight="Bold" Foreground="#1565C0"
                                  Margin="0,0,0,10"/>
                        <ItemsControl x:Name="icAssetsByStatus">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="12" Height="12"
                                               CornerRadius="6"
                                               Background="{Binding Color}"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                  Text="{Binding StatusName}"
                                                  FontSize="13" Foreground="#424242"
                                                  VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2"
                                                  Text="{Binding Count}"
                                                  FontSize="15" FontWeight="Bold"
                                                  Foreground="#1565C0"
                                                  VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══ آخر سجلات التدقيق ═══ -->
            <Border Style="{StaticResource DashCardStyle}"
                   Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                   Margin="8,5,8,15">
                <StackPanel>
                    <TextBlock Text="📝  آخر العمليات المسجلة" FontSize="16"
                              FontWeight="Bold" Foreground="#1565C0"
                              Margin="0,0,0,10"/>
                    <DataGrid x:Name="dgRecentAudit"
                             AutoGenerateColumns="False"
                             IsReadOnly="True"
                             HeadersVisibility="Column"
                             GridLinesVisibility="Horizontal"
                             BorderThickness="0"
                             FontSize="12"
                             MaxHeight="150"
                             CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="التاريخ"
                                Binding="{Binding ActionDate, StringFormat={}{0:MM/dd HH:mm}}"
                                Width="100"/>
                            <DataGridTextColumn Header="المستخدم"
                                Binding="{Binding FullName}" Width="120"/>
                            <DataGridTextColumn Header="العملية"
                                Binding="{Binding ActionType}" Width="80"/>
                            <DataGridTextColumn Header="التفاصيل"
                                Binding="{Binding NewValues}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>