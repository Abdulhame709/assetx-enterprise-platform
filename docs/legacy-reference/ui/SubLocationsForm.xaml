<Window x:Class="AssetManagement.Views.SubLocationsForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إدارة المواقع الفرعية"
        Height="750" Width="1100"
        MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI"
        FontSize="14"
        Background="#F5F5F5"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#1565C0"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════ -->
        <!-- العنوان                                     -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#1565C0" CornerRadius="8"
                Padding="15,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="🚪" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="إدارة المواقع الفرعية (أدوار / غرف / أقسام)"
                               FontSize="18" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Column="1" Background="#1976D2" CornerRadius="5" Padding="10,3">
                    <TextBlock x:Name="txtFormMode" Text="وضع العرض"
                               Foreground="White" FontSize="12" FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════ -->
        <!-- المحتوى الرئيسي: شجرة + حقول + جدول       -->
        <!-- ═══════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════ اللوحة اليسرى: الشجرة الهرمية ═══════ -->
            <Border Grid.Column="0" Background="White" CornerRadius="8"
                    BorderBrush="#E0E0E0" BorderThickness="1"
                    Margin="0,0,10,0" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- عنوان الشجرة -->
                    <TextBlock Grid.Row="0" Text="🌳 الشجرة الهرمية"
                               FontSize="15" FontWeight="Bold"
                               Foreground="#1565C0" Margin="0,0,0,8"/>

                    <!-- اختيار المبنى للشجرة -->
                    <ComboBox Grid.Row="1" x:Name="cmbTreeMainLocation"
                              Style="{StaticResource ComboStyle}"
                              DisplayMemberPath="MainLocationName"
                              SelectedValuePath="MainLocationID"
                              SelectionChanged="cmbTreeMainLocation_SelectionChanged"
                              Margin="0,0,0,8"/>

                    <!-- الشجرة -->
                    <TreeView Grid.Row="2" x:Name="treeLocations"
                              BorderThickness="1" BorderBrush="#E0E0E0"
                              FontSize="14"
                              SelectedItemChanged="treeLocations_SelectedItemChanged">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="True"/>
                                <Setter Property="Padding" Value="3"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </Grid>
            </Border>

            <!-- ═══════ اللوحة اليمنى: حقول + جدول ═══════ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ═══ حقول الإدخال ═══ -->
                <Border Grid.Row="0" Background="White" CornerRadius="8"
                        Padding="15,12" Margin="0,0,0,8"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- السطر 1: المبنى والموقع الأب -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="المبنى:"
                                   Style="{StaticResource FieldLabel}"/>
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  x:Name="cmbMainLocation"
                                  Style="{StaticResource ComboStyle}"
                                  DisplayMemberPath="DisplayText"
                                  SelectedValuePath="MainLocationID"
                                  SelectionChanged="cmbMainLocation_SelectionChanged"/>

                        <TextBlock Grid.Row="0" Grid.Column="3" Text="الموقع الأب:"
                                   Style="{StaticResource FieldLabel}"/>
                        <ComboBox Grid.Row="0" Grid.Column="4"
                                  x:Name="cmbParentSubLocation"
                                  Style="{StaticResource ComboStyle}"
                                  DisplayMemberPath="DisplayText"
                                  SelectedValuePath="SubLocationID"
                                  SelectionChanged="cmbParentSubLocation_SelectionChanged"/>

                        <!-- السطر 2: الكود والاسم -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="الكود:"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 x:Name="txtSubLocationCode"
                                 Style="{StaticResource InputField}"
                                 IsEnabled="False"
                                 Background="#F5F5F5"/>

                        <TextBlock Grid.Row="2" Grid.Column="3" Text="اسم الموقع:"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="2" Grid.Column="4"
                                 x:Name="txtSubLocationName"
                                 Style="{StaticResource InputField}"
                                 MaxLength="100"/>

                        <!-- السطر 3: الوصف -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="الوصف:"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4"
                                 x:Name="txtDescription"
                                 Style="{StaticResource InputField}"
                                 MaxLength="300"/>

                        <!-- السطر 4: المسار الكامل والمستوى -->
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="المسار:"
                                   Style="{StaticResource FieldLabel}"/>
                        <Border Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="4"
                                Background="#E3F2FD" CornerRadius="4" Padding="8,4">
                            <TextBlock x:Name="txtFullPath" Text="..."
                                       FontSize="13" Foreground="#1565C0"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <!-- السطر 5: المستوى ونشط -->
                        <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                                    Orientation="Horizontal">
                            <TextBlock Text="المستوى:" Style="{StaticResource FieldLabel}"/>
                            <Border Background="#FF8F00" CornerRadius="10"
                                    Padding="10,2" Margin="5,0,0,0">
                                <TextBlock x:Name="txtLevelNumber" Text="1"
                                           Foreground="White" FontWeight="Bold" FontSize="13"/>
                            </Border>
                        </StackPanel>

                        <CheckBox Grid.Row="8" Grid.Column="3" Grid.ColumnSpan="2"
                                  x:Name="chkIsActive"
                                  Content="  نشط (مفعّل)"
                                  IsChecked="True"
                                  FontSize="14"
                                  VerticalAlignment="Center"/>

                        <TextBox x:Name="txtSubLocationID" Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <!-- ═══ أزرار التحكم ═══ -->
                <Border Grid.Row="1" Margin="0,0,0,8">
                    <WrapPanel HorizontalAlignment="Center">
                        <Button x:Name="btnNew" Content="➕ جديد"
                                Background="#4CAF50" Foreground="White"
                                Style="{StaticResource ActionButton}"
                                Click="btnNew_Click"/>
                        <Button x:Name="btnSave" Content="💾 حفظ"
                                Background="#1565C0" Foreground="White"
                                Style="{StaticResource ActionButton}"
                                Click="btnSave_Click"/>
                        <Button x:Name="btnEdit" Content="✏️ تعديل"
                                Background="#FF8F00" Foreground="White"
                                Style="{StaticResource ActionButton}"
                                Click="btnEdit_Click" IsEnabled="False"/>
                        <Button x:Name="btnDelete" Content="🗑️ حذف"
                                Background="#D32F2F" Foreground="White"
                                Style="{StaticResource ActionButton}"
                                Click="btnDelete_Click" IsEnabled="False"/>
                        <Button x:Name="btnToggleActive" Content="🔄 الحالة"
                                Background="#7B1FA2" Foreground="White"
                                Style="{StaticResource ActionButton}"
                                Click="btnToggleActive_Click" IsEnabled="False"/>
                        <Button x:Name="btnCancel" Content="↩️ إلغاء"
                                Background="#757575" Foreground="White"
                                Style="{StaticResource ActionButton}"
                                Click="btnCancel_Click"/>
                    </WrapPanel>
                </Border>

                <!-- ═══ جدول البيانات ═══ -->
                <Border Grid.Row="2" Background="White" CornerRadius="8"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <DataGrid x:Name="dgSubLocations"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              Background="White"
                              RowBackground="White"
                              AlternatingRowBackground="#F5F5F5"
                              FontSize="13"
                              ColumnHeaderHeight="38"
                              RowHeight="32"
                              SelectionChanged="dgSubLocations_SelectionChanged">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#1565C0"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Padding" Value="8,0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Right"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الكود" Binding="{Binding SubLocationCode}" Width="110"/>
                            <DataGridTextColumn Header="اسم الموقع" Binding="{Binding SubLocationName}" Width="150"/>
                            <DataGridTextColumn Header="المسار الكامل" Binding="{Binding FullPath}" Width="*"/>
                            <DataGridTextColumn Header="المستوى" Binding="{Binding LevelNumber}" Width="60"/>
                            <DataGridCheckBoxColumn Header="نشط" Binding="{Binding IsActive}" Width="50"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════ -->
        <!-- شريط الحالة                                 -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#263238" CornerRadius="5" Padding="10,5" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="txtFormStatus" Text="جاهز"
                           Foreground="#B0BEC5" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="txtRecordCount" Text="عدد السجلات: 0"
                           Foreground="#B0BEC5" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>