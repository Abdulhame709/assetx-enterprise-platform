<Window x:Class="AssetManagement.Views.BackupForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="النسخ الاحتياطي واستعادة البيانات"
        Width="650" Height="500"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- العنوان -->
        <TextBlock Text="💾  النسخ الاحتياطي واستعادة البيانات" FontSize="20"
                  FontWeight="Bold" Foreground="#1565C0"
                  Margin="0,0,0,20"/>

        <!-- ═══ قسم النسخ الاحتياطي ═══ -->
        <Border Grid.Row="1" Background="#E8F5E9" CornerRadius="10"
               Padding="20" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="📤  إنشاء نسخة احتياطية" FontSize="16"
                          FontWeight="Bold" Foreground="#2E7D32"
                          Margin="0,0,0,15"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="مسار الحفظ:" FontSize="13"
                              VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" x:Name="txtBackupPath" FontSize="13"
                            Padding="8,6" FlowDirection="LeftToRight"
                            IsReadOnly="True" Background="#F5F5F5"/>
                    <Button Grid.Column="2" Content="📁 تصفح" Background="#4CAF50"
                           Foreground="White" FontSize="13"
                           Padding="15,6" Margin="10,0,0,0"
                           BorderThickness="0" Cursor="Hand"
                           Click="BtnBrowseBackup_Click"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,15,0,0"
                           HorizontalAlignment="Center">
                    <Button x:Name="btnBackup" Content="💾 إنشاء نسخة احتياطية الآن"
                           Background="#2E7D32" Foreground="White"
                           FontSize="14" FontWeight="Bold"
                           Padding="30,10" Cursor="Hand"
                           BorderThickness="0"
                           Click="BtnBackup_Click"/>
                </StackPanel>

                <ProgressBar x:Name="progressBackup" Height="5"
                           Margin="0,10,0,0" Visibility="Collapsed"
                           IsIndeterminate="True" Foreground="#4CAF50"/>
            </StackPanel>
        </Border>

        <!-- ═══ قسم الاستعادة ═══ -->
        <Border Grid.Row="2" Background="#FFF3E0" CornerRadius="10"
               Padding="20" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="📥  استعادة نسخة احتياطية" FontSize="16"
                          FontWeight="Bold" Foreground="#E65100"
                          Margin="0,0,0,10"/>

                <TextBlock Text="⚠️ تحذير: استعادة النسخة الاحتياطية ستستبدل جميع البيانات الحالية!"
                          FontSize="12" Foreground="#BF360C"
                          TextWrapping="Wrap" Margin="0,0,0,15"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="ملف النسخة:" FontSize="13"
                              VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" x:Name="txtRestorePath" FontSize="13"
                            Padding="8,6" FlowDirection="LeftToRight"
                            IsReadOnly="True" Background="#F5F5F5"/>
                    <Button Grid.Column="2" Content="📁 تصفح" Background="#FF9800"
                           Foreground="White" FontSize="13"
                           Padding="15,6" Margin="10,0,0,0"
                           BorderThickness="0" Cursor="Hand"
                           Click="BtnBrowseRestore_Click"/>
                </Grid>

                <Button x:Name="btnRestore" Content="📥 استعادة النسخة الاحتياطية"
                       Background="#E65100" Foreground="White"
                       FontSize="14" FontWeight="Bold"
                       Padding="30,10" Margin="0,15,0,0" Cursor="Hand"
                       BorderThickness="0" HorizontalAlignment="Center"
                       Click="BtnRestore_Click"/>
            </StackPanel>
        </Border>

        <!-- ═══ السجل ═══ -->
        <Border Grid.Row="3" Background="White" CornerRadius="8"
               BorderBrush="#E0E0E0" BorderThickness="1" Padding="10">
            <StackPanel>
                <TextBlock Text="📋  سجل العمليات" FontSize="14"
                          FontWeight="Bold" Foreground="#424242"
                          Margin="0,0,0,8"/>
                <TextBox x:Name="txtLog" IsReadOnly="True"
                        FontSize="12" TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto"
                        MaxHeight="120" Background="#FAFAFA"
                        BorderThickness="0" FlowDirection="RightToLeft"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>