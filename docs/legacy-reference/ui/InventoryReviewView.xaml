<Window x:Class="AssetManagement.Views.InventoryReviewView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مراجعة نتائج الجرد"
        Height="800" Width="1250"
        MinHeight="650" MinWidth="1000"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F0F2F5"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="BtnStyle" TargetType="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinWidth" Value="95"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="1" Opacity="0.12" BlurRadius="5"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LblStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#34495E"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: الشريط العلوي -->
        <Border Grid.Row="0" Background="#2C3E50" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
            <Grid>
                <TextBlock Text="مراجعة نتائج الجرد" FontSize="18" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="الدورة:" FontSize="13" Foreground="#BDC3C7" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="cmbCycles" Width="250" Height="28" FontSize="12"
                              SelectionChanged="cmbCycles_SelectionChanged" Margin="0,0,10,0"/>
                    <TextBlock x:Name="txtCycleStatus" FontSize="12" FontWeight="Bold"
                               Foreground="#F1C40F" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: بطاقات الإحصائيات (قابلة للنقر) -->
        <WrapPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,6">
            <Border Style="{StaticResource StatCard}" BorderBrush="#3498DB" BorderThickness="0,3,0,0"
                    Tag="الكل" MouseDown="StatCard_MouseDown">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="إجمالي" FontSize="10" Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="lblTotal" Text="0" FontSize="20" FontWeight="Bold" Foreground="#3498DB" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}" BorderBrush="#2ECC71" BorderThickness="0,3,0,0"
                    Tag="الكل" MouseDown="StatCard_MouseDown">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="تم جردها" FontSize="10" Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="lblInventoried" Text="0" FontSize="20" FontWeight="Bold" Foreground="#2ECC71" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}" BorderBrush="#1ABC9C" BorderThickness="0,3,0,0"
                    Tag="الكل" MouseDown="StatCard_MouseDown">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="تم التحقق" FontSize="10" Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="lblVerified" Text="0" FontSize="20" FontWeight="Bold" Foreground="#1ABC9C" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}" BorderBrush="#27AE60" BorderThickness="0,3,0,0"
                    Tag="مطابق" MouseDown="StatCard_MouseDown">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="مطابق" FontSize="10" Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="lblMatched" Text="0" FontSize="20" FontWeight="Bold" Foreground="#27AE60" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}" BorderBrush="#F39C12" BorderThickness="0,3,0,0"
                    Tag="عجز" MouseDown="StatCard_MouseDown">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="عجز" FontSize="10" Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="lblDeficit" Text="0" FontSize="20" FontWeight="Bold" Foreground="#F39C12" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}" BorderBrush="#9B59B6" BorderThickness="0,3,0,0"
                    Tag="زيادة" MouseDown="StatCard_MouseDown">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="زيادة" FontSize="10" Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="lblSurplus" Text="0" FontSize="20" FontWeight="Bold" Foreground="#9B59B6" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}" BorderBrush="#3498DB" BorderThickness="0,3,0,0"
                    Tag="منقول" MouseDown="StatCard_MouseDown">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="منقول" FontSize="10" Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="lblTransferred" Text="0" FontSize="20" FontWeight="Bold" Foreground="#3498DB" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}" BorderBrush="#E74C3C" BorderThickness="0,3,0,0"
                    Tag="مفقود" MouseDown="StatCard_MouseDown">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="مفقود" FontSize="10" Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="lblMissing" Text="0" FontSize="20" FontWeight="Bold" Foreground="#E74C3C" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}" BorderBrush="#95A5A6" BorderThickness="0,3,0,0"
                    Tag="لم يُجرد" MouseDown="StatCard_MouseDown">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="لم يُجرد" FontSize="10" Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="lblNotDone" Text="0" FontSize="20" FontWeight="Bold" Foreground="#95A5A6" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </WrapPanel>

        <!-- Row 2: الفلاتر -->
        <Border Grid.Row="2" Background="White" CornerRadius="6" Padding="8" Margin="0,0,0,6">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="بحث:" Style="{StaticResource LblStyle}"/>
                <TextBox x:Name="txtSearch" Width="160" Height="26" FontSize="12" Padding="4,2" Margin="0,0,10,0"
                         TextChanged="txtSearch_TextChanged"/>

                <TextBlock Text="الموقع:" Style="{StaticResource LblStyle}"/>
                <ComboBox x:Name="cmbFilterLocation" Width="140" Height="26" FontSize="12" Margin="0,0,5,0"
                          SelectionChanged="cmbFilterLocation_SelectionChanged"/>

                <TextBlock Text="الفرعي:" Style="{StaticResource LblStyle}"/>
                <ComboBox x:Name="cmbFilterSubLocation" Width="130" Height="26" FontSize="12" Margin="0,0,10,0"
                          SelectionChanged="cmbFilterSubLocation_SelectionChanged"/>

                <TextBlock Text="الموظف:" Style="{StaticResource LblStyle}"/>
                <ComboBox x:Name="cmbFilterEmployee" Width="140" Height="26" FontSize="12" Margin="0,0,10,0"
                          SelectionChanged="cmbFilterEmployee_SelectionChanged"/>

                <TextBlock Text="النتيجة:" Style="{StaticResource LblStyle}"/>
                <ComboBox x:Name="cmbFilterResult" Width="100" Height="26" FontSize="12" Margin="0,0,5,0"
                          SelectionChanged="cmbFilterResult_SelectionChanged"/>

                <TextBlock Text="التحقق:" Style="{StaticResource LblStyle}"/>
                <ComboBox x:Name="cmbFilterVerified" Width="100" Height="26" FontSize="12" Margin="0,0,10,0"
                          SelectionChanged="cmbFilterVerified_SelectionChanged"/>

                <TextBlock x:Name="txtRecordCount" Text="عدد: 0" FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Center"/>

                <Button Content="تحديث" Background="#7F8C8D" Style="{StaticResource BtnStyle}" Click="btnRefresh_Click" Margin="8,0,0,0"/>
            </WrapPanel>
        </Border>

        <!-- Row 3: الجدول -->
        <Border Grid.Row="3" Background="White" CornerRadius="6" Padding="3" Margin="0,0,0,6">
            <DataGrid x:Name="dgRecords" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False"
                      GridLinesVisibility="Horizontal" AlternatingRowBackground="#F8F9FA"
                      RowHeight="30" ColumnHeaderHeight="33" FontSize="11" BorderThickness="0"
                      SelectionChanged="dgRecords_SelectionChanged">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#34495E"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="10"/>
                        <Setter Property="Padding" Value="5,4"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding RecordID}" Width="40"/>
                    <DataGridTextColumn Header="الكود" Binding="{Binding BaseAssetCode}" Width="85"/>
                    <DataGridTextColumn Header="اسم الأصل" Binding="{Binding AssetName}" Width="*" MinWidth="130"/>
                    <DataGridTextColumn Header="النوع الفرعي" Binding="{Binding SubTypeName}" Width="85"/>
                    <DataGridTextColumn Header="العهدة" Binding="{Binding EmployeeName}" Width="85"/>
                    <DataGridTextColumn Header="الموقع م" Binding="{Binding ExpectedMainLocName}" Width="85"/>
                    <DataGridTextColumn Header="الفرعي م" Binding="{Binding ExpectedSubLocName}" Width="85"/>
                    <DataGridTextColumn Header="كمية م" Binding="{Binding ExpectedQuantity}" Width="50"/>
                    <DataGridTextColumn Header="العهدة ف" Binding="{Binding ActualEmployeeName}" Width="80"/>
                    <DataGridTextColumn Header="الموقع ف" Binding="{Binding ActualMainLocName}" Width="85"/>
                    <DataGridTextColumn Header="كمية ف" Binding="{Binding ActualQuantity}" Width="50"/>
                    <DataGridTextColumn Header="النتيجة" Binding="{Binding InventoryResult}" Width="65">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="الجارد" Binding="{Binding InventoryBy}" Width="70"/>
                    <DataGridCheckBoxColumn Header="تحقق" Binding="{Binding IsVerified}" Width="45"/>
                    <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Row 4: لوحة المراجعة -->
        <Border Grid.Row="4" Background="White" CornerRadius="6" Padding="10" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" x:Name="txtSelectedAsset" Text="اختر سجلاً من الجدول"
                               FontSize="13" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="1" x:Name="txtComparison" FontSize="11" Foreground="#7F8C8D"
                               Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <TextBlock Text="ملاحظة:" Style="{StaticResource LblStyle}"/>
                        <TextBox x:Name="txtReviewNotes" Height="26" Width="400" FontSize="11" Padding="4,2"/>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Content="تم التحقق" Background="#27AE60" Style="{StaticResource BtnStyle}"
                            Click="btnVerify_Click" Height="30" Padding="16,4"/>
                    <Button Content="إلغاء التحقق" Background="#E67E22" Style="{StaticResource BtnStyle}"
                            Click="btnUnverify_Click" Height="30" Padding="16,4"/>
                    <Button Content="إلغاء الجرد" Background="#E74C3C" Style="{StaticResource BtnStyle}"
                            Click="btnResetRecord_Click" Height="30" Padding="16,4"/>
                    <Button Content="تحقق الكل" Background="#8E44AD" Style="{StaticResource BtnStyle}"
                            Click="btnVerifyAll_Click" Height="30" Padding="16,4" Margin="3,8,3,3"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 5: أزرار التصدير والطباعة -->
        <Border Grid.Row="5" Background="#2C3E50" CornerRadius="6" Padding="8,5">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="txtStatusBar" Text="جاهز" Foreground="#BDC3C7"
                               FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="تصدير Excel" Background="#217346" Style="{StaticResource BtnStyle}"
                            Click="btnExportExcel_Click" Margin="4,0"/>
                    <Button Content="طباعة التقرير" Background="#0277BD" Style="{StaticResource BtnStyle}"
                            Click="btnPrint_Click" Margin="4,0"/>
                    <Button Content="طباعة نموذج فارغ" Background="#6A1B9A" Style="{StaticResource BtnStyle}"
                            Click="btnPrintBlankForm_Click" Margin="4,0"/>
                    <Button Content="طباعة نموذج جرد فارغ" Background="#6A1B9A"
        Style="{StaticResource BtnStyle}" Click="btnPrintBlankForm_Click"
        x:Name="btnPrintForm" FontSize="14" Padding="25,10"/>
                </StackPanel>
                <Button Content="إغلاق" Background="#E74C3C" Style="{StaticResource BtnStyle}"
                        Click="btnCloseWindow_Click" HorizontalAlignment="Left"/>
            </Grid>
        </Border>
    </Grid>
</Window>