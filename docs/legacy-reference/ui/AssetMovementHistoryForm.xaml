<Window x:Class="AssetManagement.Views.AssetMovementHistoryForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="سجل حركة الأصول"
        Width="1200" Height="700"
        MinWidth="900" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI"
        FontSize="14"
        Background="#F0F2F5">

    <Window.Resources>
        <!-- ستايل الأزرار -->
        <Style x:Key="FilterButton" TargetType="Button">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2980B9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#21618C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResetButton" TargetType="Button">
            <Setter Property="Background" Value="#95A5A6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#7F8C8D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExportButton" TargetType="Button">
            <Setter Property="Background" Value="#27AE60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#229954"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DetailButton" TargetType="Button">
            <Setter Property="Background" Value="#8E44AD"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#7D3C98"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ستايل حقول الإدخال -->
        <Style x:Key="FilterTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#3498DB"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="FilterDatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════ العنوان ═══════════════ -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="📋" FontSize="24" Margin="0,0,10,0"
                               VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="سجل حركة الأصول"
                                   Foreground="White" FontSize="20"
                                   FontWeight="Bold"/>
                        <TextBlock Text="عرض وتتبع جميع حركات الأصول (نقل، تسليم، استلام، إتلاف...)"
                                   Foreground="#BDC3C7" FontSize="12"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Background="#34495E"
                        CornerRadius="8" Padding="15,8"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="عدد الحركات:"
                                   Foreground="#BDC3C7" FontSize="13"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtTotalCount"
                                   Text="0" Foreground="#F1C40F"
                                   FontSize="18" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════════ منطقة الفلترة ═══════════════ -->
        <Border Grid.Row="1" Background="White" Margin="10,10,10,0"
                Padding="15" CornerRadius="8"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="5" ShadowDepth="1"
                                  Opacity="0.1" Color="Black"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ═══ الصف الأول من الفلاتر ═══ -->
                <WrapPanel Grid.Row="0" Margin="0,0,0,8">

                    <!-- بحث بالنص -->
                    <StackPanel Margin="0,0,15,5">
                        <TextBlock Text="🔍 بحث (اسم الأصل / الكود)"
                                   FontSize="11" Foreground="#7F8C8D"
                                   Margin="0,0,0,3"/>
                        <TextBox x:Name="txtSearch"
                                 Style="{StaticResource FilterTextBox}"
                                 Width="220"
                                 TextChanged="txtSearch_TextChanged"/>
                    </StackPanel>

                    <!-- نوع الحركة -->
                    <StackPanel Margin="0,0,15,5">
                        <TextBlock Text="نوع الحركة"
                                   FontSize="11" Foreground="#7F8C8D"
                                   Margin="0,0,0,3"/>
                        <ComboBox x:Name="cmbMovementType"
                                  Style="{StaticResource FilterComboBox}"
                                  Width="140"
                                  SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="-- الكل --" IsSelected="True"/>
                            <ComboBoxItem Content="نقل"/>
                            <ComboBoxItem Content="تسليم"/>
                            <ComboBoxItem Content="استلام"/>
                            <ComboBoxItem Content="إتلاف"/>
                            <ComboBoxItem Content="استغناء"/>
                            <ComboBoxItem Content="إضافة"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- من تاريخ -->
                    <StackPanel Margin="0,0,15,5">
                        <TextBlock Text="من تاريخ"
                                   FontSize="11" Foreground="#7F8C8D"
                                   Margin="0,0,0,3"/>
                        <DatePicker x:Name="dpFromDate"
                                    Style="{StaticResource FilterDatePicker}"
                                    Width="140"
                                    SelectedDateChanged="Filter_Changed"/>
                    </StackPanel>

                    <!-- إلى تاريخ -->
                    <StackPanel Margin="0,0,15,5">
                        <TextBlock Text="إلى تاريخ"
                                   FontSize="11" Foreground="#7F8C8D"
                                   Margin="0,0,0,3"/>
                        <DatePicker x:Name="dpToDate"
                                    Style="{StaticResource FilterDatePicker}"
                                    Width="140"
                                    SelectedDateChanged="Filter_Changed"/>
                    </StackPanel>

                </WrapPanel>

                <!-- ═══ الصف الثاني: فلاتر المواقع والموظفين ═══ -->
                <WrapPanel Grid.Row="1" Margin="0,0,0,8">

                    <!-- الموقع الرئيسي -->
                    <StackPanel Margin="0,0,15,5">
                        <TextBlock Text="🏢 الموقع الرئيسي"
                                   FontSize="11" Foreground="#7F8C8D"
                                   Margin="0,0,0,3"/>
                        <ComboBox x:Name="cmbMainLocation"
                                  Style="{StaticResource FilterComboBox}"
                                  Width="180"
                                  DisplayMemberPath="MainLocationName"
                                  SelectedValuePath="MainLocationID"
                                  SelectionChanged="cmbMainLocation_SelectionChanged"/>
                    </StackPanel>

                    <!-- الموقع الفرعي -->
                    <StackPanel Margin="0,0,15,5">
                        <TextBlock Text="🚪 الموقع الفرعي"
                                   FontSize="11" Foreground="#7F8C8D"
                                   Margin="0,0,0,3"/>
                        <ComboBox x:Name="cmbSubLocation"
                                  Style="{StaticResource FilterComboBox}"
                                  Width="200"
                                  DisplayMemberPath="SubLocationName"
                                  SelectedValuePath="SubLocationID"
                                  SelectionChanged="Filter_Changed"
                                  IsEnabled="False"/>
                    </StackPanel>

                    <!-- عهدة الموظف (مسؤول الأصل) -->
                    <StackPanel Margin="0,0,15,5">
                        <TextBlock Text="👤 عهدة الموظف (من / إلى)"
                                   FontSize="11" Foreground="#7F8C8D"
                                   Margin="0,0,0,3"/>
                        <ComboBox x:Name="cmbEmployee"
                                  Style="{StaticResource FilterComboBox}"
                                  Width="200"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="EmployeeID"
                                  SelectionChanged="Filter_Changed"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  IsTextSearchCaseSensitive="False"/>
                    </StackPanel>

                </WrapPanel>

                <!-- ═══ الصف الثالث: أزرار ═══ -->
                <StackPanel Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Left">
                    <Button Content="🔍 بحث وفلترة"
                            Style="{StaticResource FilterButton}"
                            Click="btnFilter_Click"/>
                    <Button Content="🔄 إعادة تعيين"
                            Style="{StaticResource ResetButton}"
                            Click="btnReset_Click"/>

                    <Border Width="1" Background="#E0E0E0"
                            Margin="15,0"/>

                    <Button Content="📥 تصدير Excel"
                            Style="{StaticResource ExportButton}"
                            Click="btnExportExcel_Click"/>
                    <Button Content="🖨️ طباعة"
                            Style="{StaticResource FilterButton}"
                            Click="btnPrint_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════ جدول البيانات ═══════════════ -->
        <Border Grid.Row="2" Background="White" Margin="10"
                Padding="0" CornerRadius="8"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="5" ShadowDepth="1"
                                  Opacity="0.1" Color="Black"/>
            </Border.Effect>

            <DataGrid x:Name="dgMovements"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      AlternatingRowBackground="#F8F9FA"
                      RowBackground="White"
                      BorderThickness="0"
                      FontSize="12"
                      ColumnHeaderHeight="40"
                      RowHeight="35"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      MouseDoubleClick="dgMovements_MouseDoubleClick">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#34495E"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="BorderBrush" Value="#2C3E50"/>
                        <Setter Property="BorderThickness" Value="0,0,1,0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <!-- رقم -->
                    <DataGridTextColumn Header="#"
                                        Binding="{Binding MovementID}"
                                        Width="50">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#7F8C8D"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- التاريخ -->
                    <DataGridTextColumn Header="التاريخ"
                                        Binding="{Binding MovementDate, StringFormat='{}{0:yyyy/MM/dd}'}"
                                        Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- الوقت -->
                    <DataGridTextColumn Header="الوقت"
                                        Binding="{Binding MovementDate, StringFormat='{}{0:HH:mm}'}"
                                        Width="60">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#7F8C8D"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- نوع الحركة -->
                    <DataGridTemplateColumn Header="نوع الحركة" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10"
                                        Padding="8,3"
                                        HorizontalAlignment="Center"
                                        Background="{Binding MovementTypeColor}">
                                    <TextBlock Text="{Binding MovementType}"
                                               Foreground="White"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- اسم الأصل -->
                    <DataGridTextColumn Header="اسم الأصل"
                                        Binding="{Binding AssetName}"
                                        Width="180">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#2C3E50"/>
                                <Setter Property="Padding" Value="5,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- كود الأصل -->
                    <DataGridTextColumn Header="الكود"
                                        Binding="{Binding FullAssetCode}"
                                        Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#8E44AD"/>
                                <Setter Property="FontFamily" Value="Consolas"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- الكمية -->
                    <DataGridTextColumn Header="الكمية"
                                        Binding="{Binding Quantity}"
                                        Width="55">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- من موقع -->
                    <DataGridTextColumn Header="من موقع"
                                        Binding="{Binding FromLocation}"
                                        Width="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#E74C3C"/>
                                <Setter Property="Padding" Value="5,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- إلى موقع -->
                    <DataGridTextColumn Header="إلى موقع"
                                        Binding="{Binding ToLocation}"
                                        Width="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#27AE60"/>
                                <Setter Property="Padding" Value="5,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- من موظف -->
                    <DataGridTextColumn Header="من موظف"
                                        Binding="{Binding FromEmployee}"
                                        Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="5,0"/>
                                <Setter Property="Foreground" Value="#D35400"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- إلى موظف -->
                    <DataGridTextColumn Header="إلى موظف"
                                        Binding="{Binding ToEmployee}"
                                        Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="5,0"/>
                                <Setter Property="Foreground" Value="#16A085"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- السبب -->
                    <DataGridTextColumn Header="السبب"
                                        Binding="{Binding Reason}"
                                        Width="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#7F8C8D"/>
                                <Setter Property="Padding" Value="5,0"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- بواسطة -->
                    <DataGridTextColumn Header="بواسطة"
                                        Binding="{Binding CreatedBy}"
                                        Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#7F8C8D"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- زر التفاصيل -->
                    <DataGridTemplateColumn Header="تفاصيل" Width="65">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="👁️"
                                        Style="{StaticResource DetailButton}"
                                        Click="btnViewDetail_Click"
                                        Tag="{Binding MovementID}"
                                        ToolTip="عرض التفاصيل"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ═══════════════ شريط الحالة ═══════════════ -->
        <Border Grid.Row="3" Background="#2C3E50" Padding="15,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           x:Name="txtStatusMessage"
                           Text="جاهز"
                           Foreground="#BDC3C7" FontSize="12"
                           VerticalAlignment="Center"/>

                <Border Grid.Column="1" Background="#3498DB"
                        CornerRadius="4" Padding="10,3" Margin="5,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="نقل: " Foreground="White" FontSize="11"/>
                        <TextBlock x:Name="txtTransferCount"
                                   Text="0" Foreground="White"
                                   FontSize="11" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#F39C12"
                        CornerRadius="4" Padding="10,3" Margin="5,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="تسليم: " Foreground="White" FontSize="11"/>
                        <TextBlock x:Name="txtDeliveryCount"
                                   Text="0" Foreground="White"
                                   FontSize="11" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="#27AE60"
                        CornerRadius="4" Padding="10,3" Margin="5,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="استلام: " Foreground="White" FontSize="11"/>
                        <TextBlock x:Name="txtReceiveCount"
                                   Text="0" Foreground="White"
                                   FontSize="11" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Background="#E74C3C"
                        CornerRadius="4" Padding="10,3" Margin="5,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="إتلاف: " Foreground="White" FontSize="11"/>
                        <TextBlock x:Name="txtDisposalCount"
                                   Text="0" Foreground="White"
                                   FontSize="11" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>