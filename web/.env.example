# AssetX Web environment (Phase PRE-P3.1)
# Copy to .env.local (development) / .env.production (production) as needed.

# ---------------------------------------------------------------------------
# Browser API routing
# ---------------------------------------------------------------------------
# Keep browser traffic on the same origin. Next.js proxies /api server-side to
# API_PROXY_TARGET, so mobile and external-preview users never call their own
# device's localhost by mistake.
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_AUTH_MODE=real        # real = backend auth; mock = P1 demo (dev only)

# ---------------------------------------------------------------------------
# Next.js server routing (development and production)
# ---------------------------------------------------------------------------
# API_PROXY_TARGET=http://127.0.0.1:3001

# ---------------------------------------------------------------------------
# Production
# ---------------------------------------------------------------------------
# API_PROXY_TARGET=http://backend:3001
# NEXT_PUBLIC_AUTH_MODE=real
