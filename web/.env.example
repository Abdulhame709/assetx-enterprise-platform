# AssetX Web environment (Phase PRE-P3.1)
# Copy to .env.local and adjust for your environment.

# Real backend base URL (NestJS on :3001)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Auth mode:
#   real — real backend authentication + data
#   mock — P1 demo accounts (controlled development fallback only)
NEXT_PUBLIC_AUTH_MODE=real
